---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { SITE, issueUrl } from '../config/site';
---
<Base title="Contact" description="How to reach the Algeria Earth Observatory maintainers, publicly or privately.">
  <PageHeader eyebrow="Contact" title="Contact the maintainers" />
  <div class="container-aeo py-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
    <div class="card p-6">
      <h2 class="text-lg font-semibold">Public questions and proposals</h2>
      <p class="mt-2 text-[0.93rem] text-slate">Questions about datasets, proposals and error reports are best handled in public so that answers help everyone.</p>
      <ul class="mt-4 space-y-1.5 text-[0.93rem]">
        <li><a href={issueUrl('dataset-proposal.yml')} rel="noopener">Propose a dataset</a></li>
        <li><a href={issueUrl('metadata-error.yml')} rel="noopener">Report an error</a></li>
        <li><a href={`${SITE.github.repoUrl}/issues`} rel="noopener">All open issues</a></li>
      </ul>
    </div>
    <div class="card p-6">
      <h2 class="text-lg font-semibold">Private matters</h2>
      {SITE.contactEmail ? (
        <p class="mt-2 text-[0.93rem] text-slate">For matters that should not be public, write to <a href={`mailto:${SITE.contactEmail}`}>{SITE.contactEmail}</a>.</p>
      ) : (
        <p class="mt-2 text-[0.93rem] text-slate">
          A dedicated contact address for the Observatory is being set up. Until then, open a public issue stating only that you need a private
          conversation (without details), and a maintainer will reply with a private channel.
        </p>
      )}
      <p class="mt-3 text-[0.85rem] text-slate">Never post personal data, exact field locations or restricted data in public issues.</p>
    </div>
    <div class="card p-6">
      <h2 class="text-lg font-semibold">Security</h2>
      <p class="mt-2 text-[0.93rem] text-slate">Report vulnerabilities privately through GitHub’s private vulnerability reporting, as described in the security policy.</p>
      <p class="mt-4 text-[0.93rem]"><a href={`${SITE.github.repoUrl}/security`} rel="noopener">Security policy</a></p>
    </div>
  </div>
</Base>
