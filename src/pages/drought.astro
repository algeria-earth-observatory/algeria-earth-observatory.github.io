  .link-btn { color: var(--color-cobalt); text-decoration: underline; text-underline-offset: 2px; }
  .link-btn:hover { color: var(--color-cobalt-hover); }
  .az-tab { min-height: 2.5rem; padding: 0 .9rem; margin-bottom: -1px; font-size: .875rem; color: var(--color-slate); border-bottom: 2px solid transparent; }
  .az-tab:hover { color: var(--color-midnight); }
  .az-tab[aria-selected='true'] { color: var(--color-midnight); font-weight: 500; border-bottom-color: var(--color-cobalt); }
  @media print {
    :global(header), :global(footer), #az-form, [role='tablist'], #az-print, #az-dl-results { display: none !important; }
    [role='tabpanel'] { display: block !important; }
  }
</style>

<script>
  import { initAnalyze } from '../scripts/analyze';
  initAnalyze();
</script>
