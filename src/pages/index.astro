---
import Base from '../layouts/Base.astro';
import DatasetCard from '../components/DatasetCard.astro';
import { getDatasets } from '../lib/catalog';
import { THEMATIC_DOMAINS } from '../lib/domains';
import { fmtDate } from '../lib/format';
import { SITE } from '../config/site';

const all = await getDatasets();
const published = all.filter((d) => d.status !== 'in-preparation');
const featured = published.filter((d) => d.featured).slice(0, 6);
const latest = [...published]
  .sort((a, b) => (b.added_date ?? b.verification.checked).localeCompare(a.added_date ?? a.verification.checked) || a.title.localeCompare(b.title))
  .slice(0, 5);
const nByDomain = (id: string) => published.filter((d) => d.domain.includes(id as never)).length;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'DataCatalog',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  inLanguage: 'en',
};

const icons: Record<string, string> = {
  agriculture: 'M4 20h16M7 20c0-5 2-9 5-12M12 8c3 3 5 7 5 12M12 8V3M9 5l3 3 3-3',
  'climate-drought': 'M7 15a4 4 0 1 1 1-7.9A5 5 0 0 1 18 9a3 3 0 0 1-1 5.8M9 18l-1 2M13 18l-1 2M17 17l-1 2',
  water: 'M12 3s6 6.5 6 11a6 6 0 0 1-12 0c0-4.5 6-11 6-11ZM9 15a3 3 0 0 0 3 3',
  'land-ecosystems': 'M3 19l6-9 4 6 3-4 5 7H3ZM16 6a2 2 0 1 0 0-.01',
  hazards: 'M12 3l9 16H3L12 3ZM12 10v4M12 17h.01',
  'human-change': 'M4 20V10l5-3v13M9 20V5l6 3v12M15 20v-8l5 2v6M3 20h18',
};
---
<Base description="Discover, explore and access documented Earth observation and environmental data across Algeria — agriculture, climate and drought, water, land, hazards." jsonLd={jsonLd}>
  <!-- 1. Hero -->
  <section class="relative overflow-hidden bg-atlas text-white">
    <div class="container-aeo grid items-center gap-10 py-14 lg:grid-cols-[1.05fr_1fr] lg:py-20">
      <div>
        <p class="font-mono text-xs uppercase tracking-[0.16em] text-sand">Open scientific initiative · {SITE.phase.toLowerCase()}</p>
        <h1 class="mt-4 text-[2.35rem] font-semibold leading-[1.08] tracking-tight text-white sm:text-5xl">Algeria Earth Observatory</h1>
        <p class="mt-3 text-xl font-medium text-[#9fd3d5] sm:text-2xl">Open Earth Data for Algeria</p>
        <p class="mt-6 max-w-xl text-[1.05rem] leading-relaxed text-[#d4dfe7]">
          Discover, explore, and download environmental and Earth observation data across Algeria. An open scientific platform
          connecting satellite observations, climate information, agricultural landscapes, and research communities.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a href="/data/" class="btn btn-primary !bg-white !text-atlas hover:!bg-[#e8f1fa]">Explore Data</a>
          <a href="/map/" class="btn btn-on-dark">Open Map</a>
        </div>
        <p class="mt-5 text-sm"><a href="/contribute/" class="text-[#9fd3d5] underline-offset-4 hover:text-white">Contribute data or expertise →</a></p>
      </div>
      <figure class="relative">
        <picture>
          <source type="image/webp" srcset="/images/hero/algeria-bluemarble-960.webp 960w, /images/hero/algeria-bluemarble-1600.webp 1600w" sizes="(min-width: 1024px) 560px, 100vw" />
          <img src="/images/hero/algeria-bluemarble-960.jpg" width="960" height="876" fetchpriority="high"
            alt="Satellite composite of Algeria with its 69 wilaya boundaries; the green Tell and Atlas in the north give way to the Sahara, its ergs and the Hoggar and Tassili massifs in the south."
            class="w-full rounded-md ring-1 ring-white/10" />
        </picture>
        <figcaption class="mt-2 font-mono text-[0.68rem] leading-snug text-[#9fb4c3]">
          NASA Blue Marble: Next Generation (MODIS composite) with shaded relief via NASA GIBS · wilaya boundaries © OpenStreetMap contributors (AEO snapshot 2026-11-19) · Web Mercator
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- 2. Domains -->
  <section class="container-aeo py-16 sm:py-20" aria-labelledby="domains-h">
    <div class="max-w-2xl">
      <p class="eyebrow">Explore by domain</p>
      <h2 id="domains-h" class="mt-2 text-3xl font-semibold">Six interconnected data domains</h2>
      <p class="mt-3 text-slate">Agriculture is the first priority: Algeria’s dryland farming systems, where telling active cultivation from fallow and non-agricultural land is a central scientific challenge.</p>
    </div>
    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {THEMATIC_DOMAINS.map((d) => (
        <a href={`/data/?domain=${d.id}`} class="card group flex flex-col p-6 no-underline transition-colors hover:border-signal">
          <div class="flex items-center justify-between">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#008C91" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={icons[d.id]} /></svg>
            {d.priority && <span class:list={['rounded px-2 py-0.5 font-mono text-[0.66rem] uppercase tracking-wider', d.priority === 'initial priority' ? 'bg-[#e3f4ee] text-[#0b5d45]' : 'bg-paper text-slate']}>{d.priority}</span>}
          </div>
          <h3 class="mt-4 text-lg font-semibold group-hover:text-signal">{d.title}</h3>
          <p class="mt-2 text-[0.92rem] leading-relaxed text-slate">{d.summary}</p>
          <p class="meta mt-auto pt-4">{nByDomain(d.id)} documented {nByDomain(d.id) === 1 ? 'record' : 'records'} →</p>
        </a>
      ))}
    </div>
  </section>

  <!-- 3. Featured datasets -->
  <section class="border-y border-line bg-paper py-16 sm:py-20" aria-labelledby="featured-h">
    <div class="container-aeo">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div class="max-w-2xl">
          <p class="eyebrow">Featured datasets</p>
          <h2 id="featured-h" class="mt-2 text-3xl font-semibold">Documented sources, honest access</h2>
          <p class="mt-3 text-slate">Each record states who produced the data, under which licence, at what resolution and period — and whether you download from AEO or from the original provider.</p>
        </div>
        <a href="/data/" class="btn btn-secondary shrink-0">Browse the full catalog</a>
      </div>
      <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
        {featured.map((d) => <DatasetCard d={d} compact />)}
      </div>
    </div>
  </section>

  <!-- 4. Explore Algeria -->
  <section class="container-aeo py-16 sm:py-20" aria-labelledby="explore-h">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.6fr] lg:items-center">
      <div>
        <p class="eyebrow">Explore Algeria</p>
        <h2 id="explore-h" class="mt-2 text-3xl font-semibold">A map built as a scientific instrument</h2>
        <p class="mt-3 text-slate">Navigate all 69 wilayas, then add land cover, vegetation, precipitation, land surface temperature, soil moisture, surface water or dust layers — each linked to its catalog record, citation and limitations.</p>
        <ul class="mt-5 space-y-2 text-[0.95rem]">
          <li class="flex gap-2"><span class="text-teal" aria-hidden="true">■</span> Time-enabled layers with date stepping</li>
          <li class="flex gap-2"><span class="text-teal" aria-hidden="true">■</span> Click a wilaya to inspect its code, names and source</li>
          <li class="flex gap-2"><span class="text-teal" aria-hidden="true">■</span> Legends and attribution for every layer</li>
        </ul>
        <a href="/map/" class="btn btn-primary mt-7">Open the map explorer</a>
      </div>
      <div>
        <div class="relative aspect-[4/3] overflow-hidden rounded-md border border-line bg-[#dfe7ec]">
          <div class="absolute inset-0"><div id="home-map" class="h-full w-full" role="region" aria-label="Interactive preview map of Algeria’s wilayas"></div></div>
          <button id="home-map-load" type="button" class="absolute inset-0 grid place-items-center bg-[#dfe7ec] text-atlas">
            <span class="btn btn-secondary">Load interactive map</span>
          </button>
        </div>
        <p class="meta mt-2">Wilaya boundaries: OpenStreetMap snapshot 2026-11-19 (ODbL), simplified for display. Basemap: OpenFreeMap / OpenStreetMap.</p>
      </div>
    </div>
  </section>

  <!-- 5. Open science -->
  <section class="bg-atlas-900 py-16 text-white sm:py-20" aria-labelledby="open-h">
    <div class="container-aeo">
      <p class="font-mono text-xs uppercase tracking-[0.14em] text-sand">Built for open science</p>
      <h2 id="open-h" class="mt-2 max-w-2xl text-3xl font-semibold text-white">From discovery to citation, every step documented</h2>
      <ol class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {[
          ['Find data', 'Search by domain, source, resolution, period, format and access type.', '/data/'],
          ['Examine methods', 'Read processing, validation status and scientific limitations before use.', '/docs/'],
          ['Download and reuse', 'Direct, checksummed downloads or verified links to the original source, with licence terms.', '/docs/data-access/'],
          ['Contribute knowledge', 'Propose datasets, correct metadata, write guides or review records.', '/contribute/'],
        ].map(([t, b, h], i) => (
          <li class="border-t border-white/20 pt-5">
            <span class="font-mono text-sm text-[#9fd3d5]">0{i + 1}</span>
            <h3 class="mt-2 text-lg font-semibold text-white"><a href={h} class="text-white no-underline hover:underline">{t}</a></h3>
            <p class="mt-2 text-[0.92rem] leading-relaxed text-[#c3d1db]">{b}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- 6. Collaborative initiative + latest additions -->
  <section class="container-aeo grid gap-12 py-16 sm:py-20 lg:grid-cols-2" aria-label="Participation and latest additions">
    <div>
      <p class="eyebrow">A collaborative initiative</p>
      <h2 class="mt-2 text-3xl font-semibold">Open to researchers, students and practitioners</h2>
      <p class="mt-4 leading-relaxed text-slate">
        AEO is an independent initiative in its initial development phase. Contributions are proposed openly on GitHub, reviewed for
        scientific documentation, licence compatibility and technical quality, and credited. You do not need to program to take part:
        dataset suggestions, metadata corrections and reviews are submitted through simple forms.
      </p>
      <div class="mt-7 flex flex-wrap gap-3">
        <a href="/contribute/" class="btn btn-primary">How to contribute</a>
        <a href="/about/" class="btn btn-secondary">About the Observatory</a>
      </div>
    </div>
    <div>
      <p class="eyebrow">Latest verified additions</p>
      <ul class="mt-4 divide-y divide-line border-y border-line">
        {latest.map((d) => (
          <li class="flex items-baseline justify-between gap-4 py-3">
            <a href={`/data/${d.id}/`} class="font-medium no-underline hover:underline">{d.title}</a>
            <span class="meta shrink-0">{fmtDate(d.added_date ?? d.verification.checked)}</span>
          </li>
        ))}
      </ul>
      <p class="mt-3 text-sm text-slate">Dates are when the record was added or last verified by AEO.</p>
    </div>
  </section>
</Base>

<script>
  const btn = document.getElementById('home-map-load');
  const box = document.getElementById('home-map');
  let started = false;
  async function start() {
    if (started || !box) return;
    started = true;
    btn?.remove();
    const core = await import('../scripts/map-core');
    const state = { basemap: 'light' as const, layers: Object.fromEntries(core.MAP_LAYERS.map((l) => [l.id, { on: l.id === 'wilayas', opacity: l.opacity, time: null }])) };
    const map = core.createMap(box, await core.buildStyle(state), { cooperativeGestures: true });
    map.addControl(new core.maplibregl.NavigationControl({ showCompass: false }), 'top-right');
    const popup = new core.maplibregl.Popup({ maxWidth: '280px' });
    map.on('click', 'aeo-wilayas-fill', (e) => {
      const f = e.features?.[0];
      if (f) popup.setLngLat(e.lngLat).setHTML(core.wilayaPopupHtml(f.properties ?? {})).addTo(map);
    });
    map.on('mouseenter', 'aeo-wilayas-fill', () => (map.getCanvas().style.cursor = 'pointer'));
    map.on('mouseleave', 'aeo-wilayas-fill', () => (map.getCanvas().style.cursor = ''));
  }
  btn?.addEventListener('click', start);
  if (box && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); start(); } }, { rootMargin: '200px' });
    io.observe(box);
  }
</script>
