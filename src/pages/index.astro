---
/**
 * Homepage: identity, the Algeria map, environmental domains, data discovery, science, community.
 * Every number on this page is computed at build time from the catalog and the published products.
 */
import Base from '../layouts/Base.astro';
import GeoBand from '../components/GeoBand.astro';
import { getDatasets } from '../lib/catalog';
import { PRIMARY_DOMAINS } from '../lib/domains';
import { SITE } from '../config/site';
import { loadRegions, fmtNum } from '../lib/regions-data';
import mapMeta from '../../public/data/aeo/products/precipitation/v1.0.0/map/map.json';
import publications from '../data/publications.json';

const all = await getDatasets();
const aeoAvailable = all.filter((d) => d.origin !== 'external' && d.status === 'available');
const external = all.filter((d) => d.origin === 'external');
const planned = all.filter((d) => d.status === 'in-preparation');
const { wilayas } = loadRegions();
const setif = wilayas.find((w) => w.code === '19')!;
const jsonLd = { '@context': 'https://schema.org', '@type': 'DataCatalog', name: SITE.name, url: SITE.url, description: SITE.description, inLanguage: 'en' };
const mapUnits = wilayas.map((w) => [w.code, w.name, w.precip?.normal ?? null]);
const DOMAIN_EXPLORE: Record<string, string> = { 'climate-drought': 'precip-annual', agriculture: 'ndvi-16day', soil: 'soil-soc', water: 'gsw-occurrence', 'land-ecosystems': 'worldcover-2021' };
const count = (id: string) => all.filter((d) => d.domain.includes(id as any)).length;
---
<Base description="Explore Algeria's land, climate, water, soils and ecosystems through open environmental data, interactive maps and reproducible scientific methods." jsonLd={jsonLd}>
  <!-- Identity -->
  <section class="mx-auto max-w-[90rem] px-5 pb-8 pt-10 sm:px-8 lg:px-12 lg:pt-14" aria-labelledby="hero-h">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="overline">Open Earth Data for Algeria</p>
        <h1 id="hero-h" class="display mt-5">Algeria Earth Observatory</h1>
      </div>
      <div class="lg:col-span-5">
        <p class="lede">Explore Algeria’s land, climate, water, soils and ecosystems through open environmental data, interactive maps and reproducible scientific methods.</p>
        <div class="mt-6 flex flex-wrap gap-3">
          <a href="/map/" class="btn btn-primary">Explore Algeria</a>
          <a href="/data/" class="btn btn-secondary">Browse Data</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Interactive Algeria map -->
  <section class="mx-auto max-w-[90rem] px-5 sm:px-8 lg:px-12" aria-labelledby="map-h">
    <h2 id="map-h" class="sr-only">Map of Algeria: mean annual precipitation by wilaya</h2>
    <div class="grid border border-line bg-surface lg:grid-cols-12" style="border-radius:var(--radius-card)">
      <div class="relative min-h-[26rem] lg:col-span-8 lg:min-h-[36rem]">
        <div class="absolute inset-0"><div id="home-map" class="h-full w-full bg-limestone" role="region" aria-label="Map of mean annual precipitation 1991–2020 by wilaya. Use the wilaya list beside the map to choose a wilaya with the keyboard."></div></div>
        <div id="home-legend" class="tabular absolute bottom-3 left-3 z-10 max-w-[calc(100%-1.5rem)] border border-line bg-white/95 px-3 py-2 text-[0.8125rem] text-graphite" style="border-radius:var(--radius-control)"></div>
      </div>
      <div class="flex flex-col gap-5 border-t border-line p-6 lg:col-span-4 lg:border-l lg:border-t-0">
        <div>
          <p class="text-[0.875rem] text-slate">Mean annual precipitation, 1991–2020</p>
          <p class="mt-1 text-[0.9375rem] text-graphite">CHIRPS v3.0, averaged over each wilaya by AEO. Click a wilaya or choose it below.</p>
        </div>
        <label class="block"><span class="block text-[0.875rem] font-medium text-atlas">Wilaya</span>
          <select id="hp-select" class="field mt-1.5 !text-[1rem]">{wilayas.map((w) => <option value={w.code} selected={w.code === '19'}>{w.code} — {w.name}</option>)}</select></label>
        <div aria-live="polite">
          <p id="hp-name" class="text-[1.25rem] font-medium text-atlas">{setif.name}</p>
          <p class="tabular mt-1"><span id="hp-normal" class="font-mono text-[2rem] text-atlas">{fmtNum(setif.precip?.normal)}</span> <span class="text-slate">mm per year</span></p>
        </div>
        <div class="mt-auto flex flex-col gap-2">
          <a id="hp-explore" href="/map/?ind=precip-annual&w=19" class="btn btn-primary justify-center">Explore <span id="hp-explore-name">{setif.name}</span></a>
          <a id="hp-profile" href="/regions/19/" class="btn btn-secondary justify-center">Wilaya profile</a>
        </div>
      </div>
    </div>
    <details class="mt-3 text-[0.9375rem]">
      <summary class="cursor-pointer text-graphite">Values for all 69 wilayas (table)</summary>
      <div class="relative mt-3 max-h-96 overflow-auto border border-line bg-surface" tabindex="0" role="region" aria-label="Mean annual precipitation by wilaya, table">
        <table class="tabular w-full text-left text-[0.9375rem]">
          <caption class="sr-only">Mean annual precipitation 1991–2020 by wilaya, CHIRPS v3.0</caption>
          <thead class="sticky top-0 bg-paper"><tr><th scope="col" class="px-3 py-2 font-medium">Code</th><th scope="col" class="px-3 py-2 font-medium">Wilaya</th><th scope="col" class="px-3 py-2 text-right font-medium">mm per year</th></tr></thead>
          <tbody>{wilayas.map((w) => <tr class="border-t border-line"><td class="px-3 py-1.5 font-mono">{w.code}</td><td class="px-3 py-1.5"><a href={`/regions/${w.code}/`}>{w.name}</a></td><td class="px-3 py-1.5 text-right">{fmtNum(w.precip?.normal)}</td></tr>)}</tbody>
        </table>
      </div>
    </details>
    <script type="application/json" id="home-data" set:html={JSON.stringify({ units: mapUnits, meta: mapMeta })} />
  </section>

  <div class="mx-auto mt-14 max-w-[90rem] px-5 sm:px-8 lg:px-12"><GeoBand /></div>

  <!-- Environmental domains -->
  <section class="mx-auto max-w-[90rem] px-5 py-14 sm:px-8 lg:px-12" aria-labelledby="dom-h">
    <h2 id="dom-h" class="h-section">Environmental domains</h2>
    <ul class="mt-8 grid gap-x-8 border-t border-line sm:grid-cols-2 lg:grid-cols-5">
      {PRIMARY_DOMAINS.map((d) => (
        <li class="border-b border-line py-5 lg:border-b-0 lg:pr-2">
          <h3 class="text-[1.0625rem] font-medium text-atlas">{d.title}</h3>
          <p class="mt-1.5 text-[0.9375rem] leading-relaxed text-slate">{d.topics.slice(0, 4).join(', ')}.</p>
          <p class="mt-3 flex flex-wrap gap-x-4 text-[0.9375rem]">
            <a href={`/map/?ind=${DOMAIN_EXPLORE[d.id] ?? ''}`}>Map</a>
            <a href={`/data/?domain=${d.id}`}>{count(d.id)} datasets</a>
          </p>
        </li>
      ))}
    </ul>
  </section>

  <!-- Data discovery -->
  <section class="border-y border-line bg-surface" aria-labelledby="disc-h">
    <div class="mx-auto grid max-w-[90rem] gap-8 px-5 py-14 sm:px-8 lg:grid-cols-12 lg:px-12">
      <div class="lg:col-span-5">
        <h2 id="disc-h" class="h-section">Find environmental data for Algeria</h2>
        <p class="mt-4 text-[1rem] leading-relaxed text-graphite">AEO connects you to the open environmental datasets that already cover Algeria, from their original providers, and publishes Algeria-ready versions of selected datasets: clipped, summarised by wilaya and commune, documented and versioned.</p>
        <div class="mt-6 flex flex-wrap gap-3"><a href="/data/" class="btn btn-primary">Browse Data</a><a href="/data/#download" class="btn btn-secondary">Download data for a place</a></div>
      </div>
      <dl class="tabular grid gap-3 sm:grid-cols-3 lg:col-span-7 lg:self-center">
        <div class="border border-line p-4" style="border-radius:var(--radius-card)"><dt class="text-[0.875rem] text-slate">Available through AEO</dt><dd class="mt-1 font-mono text-[1.75rem] text-atlas">{aeoAvailable.length}</dd><dd class="text-[0.875rem] text-slate">processed, documented, downloadable</dd></div>
        <div class="border border-line p-4" style="border-radius:var(--radius-card)"><dt class="text-[0.875rem] text-slate">From external sources</dt><dd class="mt-1 font-mono text-[1.75rem] text-atlas">{external.length}</dd><dd class="text-[0.875rem] text-slate">documented, accessed at the provider</dd></div>
        <div class="border border-line p-4" style="border-radius:var(--radius-card)"><dt class="text-[0.875rem] text-slate">Under development</dt><dd class="mt-1 font-mono text-[1.75rem] text-atlas">{planned.length}</dd><dd class="text-[0.875rem] text-slate">AEO products in preparation</dd></div>
      </dl>
    </div>
  </section>

  <!-- Science and methods -->
  <section class="mx-auto grid max-w-[90rem] gap-8 px-5 py-14 sm:px-8 lg:grid-cols-12 lg:px-12" aria-labelledby="sci-h">
    <div class="lg:col-span-5">
      <h2 id="sci-h" class="h-section">Science and methods</h2>
      <p class="mt-4 text-[1rem] leading-relaxed text-graphite">Every AEO product comes with its source, the code that made it, its validation and its limitations. Methods are tested against reference implementations, and citations are checked against their DOI records.</p>
    </div>
    <ul class="grid gap-x-8 border-t border-line sm:grid-cols-3 lg:col-span-7">
      <li class="border-b border-line py-5"><a href="/science/#methods" class="text-[1.0625rem] font-medium">Methods</a><p class="mt-1 text-[0.9375rem] text-slate">Precipitation, SPI, SPEI, soil statistics and boundaries.</p></li>
      <li class="border-b border-line py-5"><a href="/science/publications/" class="text-[1.0625rem] font-medium">Publications & References</a><p class="mt-1 text-[0.9375rem] text-slate">{publications.length} verified references behind the data and methods.</p></li>
      <li class="border-b border-line py-5"><a href="/science/#learn" class="text-[1.0625rem] font-medium">Learn with AEO</a><p class="mt-1 text-[0.9375rem] text-slate">Reproducible tutorials in Python and R.</p></li>
    </ul>
  </section>

  <!-- Community -->
  <section class="border-t border-line bg-surface" aria-labelledby="com-h">
    <div class="mx-auto flex max-w-[90rem] flex-wrap items-center justify-between gap-6 px-5 py-12 sm:px-8 lg:px-12">
      <div class="max-w-2xl">
        <h2 id="com-h" class="h-sub">Contribute</h2>
        <p class="mt-2 text-[1rem] leading-relaxed text-graphite">AEO is an independent open-science initiative. Suggest a dataset, report an error or propose a method; everything is reviewed in the open on GitHub.</p>
      </div>
      <a href="/contribute/" class="btn btn-secondary">How to contribute</a>
    </div>
  </section>
</Base>

<script>
  import maplibregl from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';

  const box = document.getElementById('home-map')!;
  const { units, meta } = JSON.parse(document.getElementById('home-data')!.textContent!);
  const $ = (id: string) => document.getElementById(id)!;
  const sel = $('hp-select') as HTMLSelectElement;
  const byCode = new Map<string, [string, string, number | null]>(units.map((u: [string, string, number | null]) => [u[0], u]));

  const color = (v: number | null) => {
    if (v === null) return '#d9dee2';
    let i = 0; while (i < meta.annual.breaks.length && v >= meta.annual.breaks[i]) i++;
    return meta.annual.colors[i];
  };
  const expr: unknown[] = ['match', ['get', 'wilaya_code']];
  for (const [code, , normal] of units) expr.push(code, color(normal));
  expr.push('#d9dee2');
  $('home-legend').innerHTML = '<p class="mb-1 text-slate">mm per year</p><ul class="flex flex-wrap gap-x-3 gap-y-1">' + meta.annual.colors.map((c: string, i: number) => {
    const lo = i ? meta.annual.breaks[i - 1] : null, hi = i < meta.annual.breaks.length ? meta.annual.breaks[i] : null;
    return `<li class="flex items-center gap-1"><span class="inline-block h-3 w-3 rounded-sm border border-black/20" style="background:${c}"></span>${lo === null ? `under ${hi}` : hi === null ? `${lo}+` : `${lo}–${hi}`}</li>`;
  }).join('') + '</ul>';

  let map: maplibregl.Map | null = null;
  function choose(code: string) {
    const u = byCode.get(code); if (!u) return;
    sel.value = code;
    map?.setFilter('w-sel', ['==', ['get', 'wilaya_code'], code]);
    $('hp-name').textContent = u[1];
    $('hp-normal').textContent = u[2] === null ? '—' : Math.round(u[2]).toLocaleString('en-US');
    $('hp-explore-name').textContent = u[1];
    ($('hp-explore') as HTMLAnchorElement).href = `/map/?ind=precip-annual&w=${code}`;
    ($('hp-profile') as HTMLAnchorElement).href = `/regions/${code}/`;
  }
  sel.addEventListener('change', () => choose(sel.value));

  map = new maplibregl.Map({ container: box, style: 'https://tiles.openfreemap.org/styles/positron', bounds: [-8.7, 18.9, 12.0, 37.2], fitBoundsOptions: { padding: 24 }, attributionControl: { compact: true }, cooperativeGestures: true });
  map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
  (window as any).__aeoHomeMap = map; // for end-to-end tests
  map.on('load', async () => {
    const m = map!;
    const data = await (await fetch('/data/aeo/boundaries/2026-11-20/dza_adm1_wilayas_display.geojson')).json();
    let last = -1; m.getStyle().layers.forEach((l, i) => { if (l.type !== 'symbol') last = i; });
    const before = m.getStyle().layers[last + 1]?.id;
    m.addSource('w', { type: 'geojson', data, promoteId: 'wilaya_code' });
    m.addLayer({ id: 'w-fill', type: 'fill', source: 'w', paint: { 'fill-color': expr as any, 'fill-opacity': 0.88 } }, before);
    m.addLayer({ id: 'w-line', type: 'line', source: 'w', paint: { 'line-color': '#ffffff', 'line-width': 0.8 } }, before);
    m.addLayer({ id: 'w-sel', type: 'line', source: 'w', paint: { 'line-color': '#17252c', 'line-width': 2.2 }, filter: ['==', ['get', 'wilaya_code'], sel.value] });
    m.addSource('outside', { type: 'geojson', data: '/data/aeo/boundaries/2026-11-20/dza_outside_mask.geojson' });
    m.addLayer({ id: 'outside-mask', type: 'fill', source: 'outside', paint: { 'fill-color': '#f2efe7', 'fill-opacity': 0.86 } }, before);
    m.on('mousemove', 'w-fill', () => { m.getCanvas().style.cursor = 'pointer'; });
    m.on('mouseleave', 'w-fill', () => { m.getCanvas().style.cursor = ''; });
    m.on('click', 'w-fill', (e) => choose(String(e.features?.[0]?.properties?.wilaya_code ?? '')));
  });
</script>
