---
import Base from '../layouts/Base.astro';
import GeoBand from '../components/GeoBand.astro';
import { getDatasets } from '../lib/catalog';
import { STATUS, period } from '../lib/format';
import { SITE } from '../config/site';
import { loadRegions, fmtNum, fmtSigned } from '../lib/regions-data';
import manifest from '../../public/data/aeo/products/precipitation/v1.0.0/manifest.json';
import mapMeta from '../../public/data/aeo/products/precipitation/v1.0.0/map/map.json';

const all = await getDatasets();
const products = all.filter((d) => d.origin !== 'external' && d.status !== 'in-preparation');
const planned = all.filter((d) => d.status === 'in-preparation').slice(0, 2);
const index = [...products, ...planned];
const { wilayas } = loadRegions();
const setif = wilayas.find((w) => w.code === '19')!;
const [y0, y1] = manifest.temporal_coverage.annual;
const short = (name = '') => { const m = name.match(/\(([^)]*)\)/); return m && !/source|processing/i.test(m[1]) ? m[1] : name.split('(')[0].split(';')[0].trim(); };
const res = (d: (typeof all)[number]) => (d.resolution?.spatial ?? '—').split(';')[0].replace(/\s*\(.*\)$/, '');
const jsonLd = { '@context': 'https://schema.org', '@type': 'DataCatalog', name: SITE.name, url: SITE.url, description: SITE.description, inLanguage: 'en' };
const mapUnits = wilayas.map((w) => [w.code, w.name, w.precip?.normal ?? null]);
const steps = [
  ['Source data', 'Satellite, gauge and reanalysis products from their original providers, with versions and licences recorded.'],
  ['Algeria processing', 'Subset to Algeria and aggregated to 69 wilayas and 1,541 communes with area-weighted, nested weights.'],
  ['Derived indicators', 'Normals, anomalies, drought indices and trends with documented statistical methods.'],
  ['Quality control', 'Automated tests for coverage, units, completeness, aggregation and checksums before every release.'],
  ['Downloads', 'GeoTIFF, CSV and Parquet with manifests, provenance and the code that produced them.'],
];
---
<Base description="Environmental observations, derived indicators and geographic analysis, prepared for Algeria: national, wilaya and commune data on precipitation, drought and land." jsonLd={jsonLd}>
  <!-- Hero: editorial split -->
  <section class="mx-auto grid max-w-[90rem] items-center gap-10 px-5 pb-16 pt-12 sm:px-8 lg:grid-cols-12 lg:gap-12 lg:px-12 lg:pb-24 lg:pt-20">
    <div class="lg:col-span-5">
      <svg viewBox="0 0 46 16" width="92" height="32" aria-hidden="true" class="text-atlas">
        <path d="M1 15 L7 1 L13 15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
        <path d="M4.4 10 H9.6" stroke="currentColor" stroke-width="2" />
        <rect x="18" y="1" width="9" height="2" fill="currentColor" /><rect x="18" y="7" width="7" height="2" fill="currentColor" /><rect x="18" y="13" width="9" height="2" fill="currentColor" />
        <path d="M38 1 L45 8 L38 15 L31 8 Z" fill="none" stroke="#B6503C" stroke-width="2" /><rect x="37" y="7" width="2" height="2" fill="#B6503C" />
      </svg>
      <p class="overline mt-8">Earth observation / Algeria</p>
      <h1 class="display mt-4">A clearer view of Algeria.</h1>
      <p class="lede mt-6">Environmental observations, derived indicators, and geographic analysis—prepared for Algeria.</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <a href="/data/" class="btn btn-primary">Explore data</a>
        <a href="/analyze/" class="btn btn-secondary">Open analysis</a>
      </div>
    </div>
    <figure class="lg:col-span-7">
      <picture>
        <source type="image/webp" srcset="/images/hero/algeria-plate-1000.webp 1000w, /images/hero/algeria-plate-1800.webp 1800w" sizes="(min-width: 1024px) 760px, 100vw" />
        <img src="/images/hero/algeria-plate-1000.jpg" width="1000" height="913" fetchpriority="high" class="h-auto w-full"
          alt="Satellite composite of Algeria: the green Tell along the Mediterranean coast, the Saharan Atlas, the ergs and the Hoggar and Tassili massifs in the south. Neighbouring areas are faded." />
      </picture>
      <figcaption class="mt-3 flex flex-wrap justify-between gap-x-6 gap-y-1 font-mono text-[0.72rem] text-slate">
        <span>NASA Blue Marble: Next Generation, shaded relief · NASA EOSDIS GIBS</span>
        <span>Web Mercator · 17.0°N–38.6°N, 11.5°W–15.5°E</span>
      </figcaption>
    </figure>
  </section>

  <div class="mx-auto max-w-[90rem] px-5 sm:px-8 lg:px-12"><GeoBand /></div>

  <!-- The Observatory -->
  <section class="border-y border-line bg-surface" aria-labelledby="obs-h">
    <div class="mx-auto grid max-w-[90rem] px-5 sm:px-8 lg:grid-cols-12 lg:px-12">
      <h2 id="obs-h" class="overline py-8 lg:col-span-3 lg:py-12">The Observatory</h2>
      <ul class="grid divide-y divide-line lg:col-span-9 lg:grid-cols-3 lg:divide-x lg:divide-y-0">
        {[
          ['Explore', 'Layered maps of precipitation, drought, land cover and cropland, shown for Algeria only.', '/map/'],
          ['Analyze', 'Time series, anomalies and trends for the country, any wilaya or any commune.', '/analyze/'],
          ['Download', 'Algeria-ready grids and statistics tables with versions, checksums and code.', '/data/'],
        ].map(([t, d, h]) => (
          <li class="py-8 lg:px-8 lg:py-12 lg:first:pl-0">
            <a href={h} class="text-[1.25rem] font-medium text-atlas no-underline hover:text-cobalt">{t}</a>
            <p class="mt-2 max-w-xs text-[0.9375rem] leading-relaxed text-slate">{d}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Featured geographic intelligence -->
  <section class="mx-auto max-w-[90rem] px-5 py-[var(--space-section)] sm:px-8 lg:px-12" aria-labelledby="geo-h">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="overline">Geographic intelligence</p>
        <h2 id="geo-h" class="h-section mt-4">Mean annual precipitation, 1991–2020</h2>
      </div>
      <p class="text-[0.9375rem] text-slate lg:col-span-5">Area-weighted means for the 69 wilayas from CHIRPS v3.0. Select a wilaya to see its annual series.</p>
    </div>
    <div class="mt-10 grid border border-line lg:grid-cols-12">
      <div class="theme-dark relative min-h-[26rem] lg:col-span-8 lg:min-h-[36rem]">
        <div class="absolute inset-0"><div id="home-map" class="h-full w-full" role="region" aria-label="Map of mean annual precipitation by wilaya"></div></div>
        <div id="home-legend" class="tabular absolute bottom-3 left-3 z-10 flex flex-wrap items-center gap-x-3 gap-y-1 bg-obsidian/85 px-3 py-2 font-mono text-[0.68rem] text-[#d9dee1]"></div>
      </div>
      <div class="flex flex-col border-t border-line bg-surface p-6 lg:col-span-4 lg:border-l lg:border-t-0" aria-live="polite">
        <dl class="grid grid-cols-[7.5rem_1fr] gap-y-2 text-[0.875rem]">
          <dt class="text-slate">Selected region</dt><dd id="hp-name" class="text-atlas">{setif.name}</dd>
          <dt class="text-slate">Indicator</dt><dd class="text-atlas">Annual precipitation</dd>
          <dt class="text-slate">Period</dt><dd class="tabular text-atlas">{y0}–{y1}</dd>
        </dl>
        <div id="hp-chart" class="mt-6" data-series={JSON.stringify({ years: setif.precip?.years, values: setif.precip?.annual, normal: setif.precip?.normal })}></div>
        <dl class="tabular mt-4 grid grid-cols-3 border-t border-line pt-4 text-[0.8125rem]">
          <div><dt class="text-slate">Normal</dt><dd id="hp-normal" class="mt-1 text-[1.125rem] text-atlas">{fmtNum(setif.precip?.normal)} mm</dd></div>
          <div><dt class="text-slate">{y1}</dt><dd id="hp-last" class="mt-1 text-[1.125rem] text-atlas">{fmtSigned(setif.precip?.last.anomaly_pct)} %</dd></div>
          <div><dt class="text-slate">Trend</dt><dd id="hp-trend" class="mt-1 text-[1.125rem] text-atlas">{fmtSigned(setif.precip?.trend.slope_mm_per_decade)} mm/10 yr</dd></div>
        </dl>
        <p id="hp-sig" class="mt-2 text-[0.75rem] text-slate">Theil–Sen slope; Mann–Kendall p = {setif.precip?.trend.mk_p?.toFixed(2)}{setif.precip?.trend.mk_p != null && setif.precip.trend.mk_p < 0.05 ? ' (significant)' : ' (not significant)'}.</p>
        <a id="hp-link" href="/analyze/?level=admin1&unit=19" class="link-arrow mt-auto pt-6 text-[0.9375rem]">Open in the analysis workspace</a>
      </div>
    </div>
    <script type="application/json" id="home-data" set:html={JSON.stringify({ units: mapUnits, meta: mapMeta })} />
  </section>

  <!-- Data products: editorial index -->
  <section class="border-t border-line bg-surface" aria-labelledby="prod-h">
    <div class="mx-auto max-w-[90rem] px-5 py-[var(--space-section)] sm:px-8 lg:px-12">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div><p class="overline">Data products</p><h2 id="prod-h" class="h-section mt-4">Prepared for Algeria</h2></div>
        <a href="/data/" class="link-arrow text-[0.9375rem]">All data</a>
      </div>
      <div class="mt-10 overflow-x-auto">
        <table class="w-full min-w-[46rem] border-collapse text-left text-[0.9375rem]">
          <thead><tr class="border-b border-atlas font-mono text-[0.72rem] uppercase tracking-[0.06em] text-slate">
            <th class="py-3 pr-6 font-normal">Product</th><th class="py-3 pr-6 font-normal">Category</th><th class="py-3 pr-6 font-normal">Period</th>
            <th class="py-3 pr-6 font-normal">Resolution</th><th class="py-3 pr-6 font-normal">Status</th><th class="py-3 font-normal">Access</th></tr></thead>
          <tbody>
            {index.map((d) => (
              <tr class="border-b border-line align-top">
                <td class="py-4 pr-6"><a href={`/data/${d.id}/`} class="text-atlas no-underline hover:text-cobalt">{d.title.split(':')[0].split(' (')[0]}</a><div class="meta mt-1 !text-[0.72rem]">{d.status === 'in-preparation' ? 'AEO product family' : short(d.provider?.name)}</div></td>
                <td class="py-4 pr-6 text-slate">{d.categories[0] ?? '—'}</td>
                <td class="tabular py-4 pr-6 font-mono text-[0.8125rem] text-graphite">{d.status === 'in-preparation' ? '—' : period(d)}</td>
                <td class="py-4 pr-6 font-mono text-[0.8125rem] text-graphite">{d.status === 'in-preparation' ? '—' : res(d)}</td>
                <td class="py-4 pr-6"><span class:list={['status', STATUS[d.status].cls]}>{STATUS[d.status].label}</span></td>
                <td class="py-4 text-[0.875rem]">{d.status === 'in-preparation' ? <span class="text-slate">Not released</span> : <a href={`/data/${d.id}/#access`}>Download</a>}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- Methodology workflow -->
  <section class="border-t border-line bg-surface" aria-labelledby="meth-h">
    <div class="mx-auto max-w-[90rem] px-5 py-[var(--space-section)] sm:px-8 lg:px-12">
      <div class="flex flex-wrap items-end justify-between gap-4">
        <div><p class="overline">Scientific methodology</p><h2 id="meth-h" class="h-section mt-4">From source to download</h2></div>
        <a href="/docs/" class="link-arrow text-[0.9375rem]">Methods</a>
      </div>
      <ol class="mt-12 grid gap-8 md:grid-cols-5 md:gap-0">
        {steps.map(([t, d], i) => (
          <li class="relative border-t border-atlas pt-5 md:pr-6">
            <span class="absolute -top-[5px] left-0 h-[9px] w-[9px] bg-cobalt" aria-hidden="true"></span>
            <p class="tabular font-mono text-[0.72rem] text-slate">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="mt-2 text-[1.0625rem]">{t}</h3>
            <p class="mt-2 text-[0.875rem] leading-relaxed text-slate">{d}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<script>
  import maplibregl from 'maplibre-gl';
  import 'maplibre-gl/dist/maplibre-gl.css';
  import { lineChart } from '../lib/charts';
  import { loadAnnual } from '../lib/precip';

  const box = document.getElementById('home-map')!;
  const { units, meta } = JSON.parse(document.getElementById('home-data')!.textContent!);
  const chartEl = document.getElementById('hp-chart')!;
  const $ = (id: string) => document.getElementById(id)!;
  const draw = (d: { years: number[]; values: (number | null)[]; normal: number | null }, label: string) =>
    lineChart(chartEl, [{ name: 'Annual precipitation', keys: d.years, values: d.values }],
      { yLabel: 'mm', reference: d.normal !== null ? { value: d.normal, label: 'normal' } : null }, `Annual precipitation, ${label}`);
  draw(JSON.parse(chartEl.dataset.series!), 'Sétif');

  const color = (v: number | null) => {
    if (v === null) return '#3d4c55';
    let i = 0; while (i < meta.annual.breaks.length && v >= meta.annual.breaks[i]) i++;
    return meta.annual.colors[i];
  };
  const expr: unknown[] = ['match', ['get', 'wilaya_code']];
  for (const [code, , normal] of units) expr.push(code, color(normal));
  expr.push('#3d4c55');
  const legend = $('home-legend');
  legend.innerHTML = '<span>mm/yr</span>' + meta.annual.colors.map((c: string, i: number) => {
    const lo = i ? meta.annual.breaks[i - 1] : null, hi = i < meta.annual.breaks.length ? meta.annual.breaks[i] : null;
    return `<span class="flex items-center gap-1"><span class="inline-block h-2 w-3" style="background:${c}"></span>${lo === null ? `<${hi}` : hi === null ? `≥${lo}` : `${lo}–${hi}`}</span>`;
  }).join('');

  const map = new maplibregl.Map({ container: box, style: 'https://tiles.openfreemap.org/styles/dark', bounds: [-8.7, 18.9, 12.0, 37.2], fitBoundsOptions: { padding: 24 }, attributionControl: { compact: true }, cooperativeGestures: true });
  map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');
  map.on('load', async () => {
    const data = await (await fetch('/data/aeo/boundaries/2026-11-20/dza_adm1_wilayas_display.geojson')).json();
    let last = -1; map.getStyle().layers.forEach((l, i) => { if (l.type !== 'symbol') last = i; });
    const before = map.getStyle().layers[last + 1]?.id;
    map.addSource('w', { type: 'geojson', data, promoteId: 'wilaya_code' });
    map.addLayer({ id: 'w-fill', type: 'fill', source: 'w', paint: { 'fill-color': expr as any, 'fill-opacity': 0.9 } }, before);
    map.addLayer({ id: 'w-line', type: 'line', source: 'w', paint: { 'line-color': '#17252c', 'line-width': 0.6 } }, before);
    map.addLayer({ id: 'w-sel', type: 'line', source: 'w', paint: { 'line-color': '#ffffff', 'line-width': 2 }, filter: ['==', ['get', 'wilaya_code'], '19'] });
    map.addSource('outside', { type: 'geojson', data: '/data/aeo/boundaries/2026-11-20/dza_outside_mask.geojson' });
    map.addLayer({ id: 'outside-mask', type: 'fill', source: 'outside', paint: { 'fill-color': '#17252c', 'fill-opacity': 0.82 } }, before);
    const annual = await loadAnnual('admin1');
    map.on('mousemove', 'w-fill', () => { map.getCanvas().style.cursor = 'pointer'; });
    map.on('mouseleave', 'w-fill', () => { map.getCanvas().style.cursor = ''; });
    map.on('click', 'w-fill', (e) => {
      const code = String(e.features?.[0]?.properties?.wilaya_code ?? '');
      const i = annual.units.findIndex((u) => u.code === code);
      if (i < 0) return;
      const u = annual.units[i], t = annual.trend[i], vals = annual.annual[i], n = annual.normal[i];
      const lastV = vals[vals.length - 1];
      map.setFilter('w-sel', ['==', ['get', 'wilaya_code'], code]);
      $('hp-name').textContent = u.name;
      $('hp-normal').textContent = `${n === null ? '—' : Math.round(n).toLocaleString('en-US')} mm`;
      $('hp-last').textContent = lastV === null || n === null || n < 1 ? '—' : `${lastV >= n ? '+' : '−'}${Math.abs(Math.round((100 * (lastV - n)) / n))} %`;
      $('hp-trend').textContent = t.slope_mm_per_decade === null ? '—' : `${t.slope_mm_per_decade >= 0 ? '+' : '−'}${Math.abs(Math.round(t.slope_mm_per_decade))} mm/10 yr`;
      $('hp-sig').textContent = t.mk_p === null ? '' : `Theil–Sen slope; Mann–Kendall p = ${t.mk_p.toFixed(2)} (${t.mk_p < 0.05 ? 'significant' : 'not significant'}).`;
      ($('hp-link') as HTMLAnchorElement).href = `/analyze/?level=admin1&unit=${code}`;
      draw({ years: annual.years, values: vals, normal: n }, u.name);
    });
  });
</script>
