---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { fmtDate } from '../../lib/format';
import { editUrl } from '../../config/site';

export async function getStaticPaths() {
  const docs = (await getCollection('docs')).sort((a, b) => a.data.order - b.data.order);
  return docs.map((entry, i) => ({ params: { slug: entry.id }, props: { entry, prev: docs[i - 1] ?? null, next: docs[i + 1] ?? null } }));
}
const { entry, prev, next } = Astro.props;
const { Content, headings } = await render(entry);
const toc = headings.filter((h) => h.depth === 2);
---
<Base title={entry.data.title} description={entry.data.description}>
  <div class="container-aeo py-10 lg:grid lg:grid-cols-[1fr_15rem] lg:gap-14">
    <article class="min-w-0">
      <nav aria-label="Breadcrumb" class="mb-5 text-sm text-slate">
        <a href="/" class="text-slate no-underline hover:text-signal">Home</a> <span aria-hidden="true">/</span>
        <a href="/docs/" class="text-slate no-underline hover:text-signal">Methods</a> <span aria-hidden="true">/</span>
        <span>{entry.data.section}</span>
      </nav>
      <h1 class="text-3xl font-semibold sm:text-[2.2rem]">{entry.data.title}</h1>
      <p class="mt-3 max-w-3xl text-lg text-slate">{entry.data.description}</p>
      <p class="meta mt-3">Updated {fmtDate(entry.data.updated)} · <a href={editUrl(`src/content/docs/${entry.id}.md`)} rel="noopener">Suggest an edit</a></p>
      <div class="prose-aeo mt-8">
        <Content />
      </div>
      <nav class="mt-14 grid gap-3 border-t border-line pt-6 sm:grid-cols-2" aria-label="More guides">
        {prev ? <a href={`/docs/${prev.id}/`} class="card p-4 no-underline hover:border-signal"><span class="meta">Previous</span><span class="mt-1 block font-medium">{prev.data.title}</span></a> : <span></span>}
        {next && <a href={`/docs/${next.id}/`} class="card p-4 text-right no-underline hover:border-signal"><span class="meta">Next</span><span class="mt-1 block font-medium">{next.data.title}</span></a>}
      </nav>
    </article>
    {toc.length > 1 && (
      <aside class="hidden lg:block" aria-label="On this page">
        <div class="sticky top-24">
          <p class="meta">On this page</p>
          <ul class="mt-3 space-y-2 border-l border-line pl-4 text-[0.88rem]">
            {toc.map((h) => <li><a href={`#${h.slug}`} class="text-slate no-underline hover:text-signal">{h.text}</a></li>)}
          </ul>
        </div>
      </aside>
    )}
  </div>
</Base>
