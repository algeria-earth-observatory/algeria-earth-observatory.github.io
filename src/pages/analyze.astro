---
import Base from '../layouts/Base.astro';
import { AGGREGATIONS, PRECIP } from '../lib/precip';
import manifest from '../../public/data/aeo/products/precipitation/v1.0.0/manifest.json';

const years = manifest.temporal_coverage.annual as [number, number];
const months = manifest.temporal_coverage.monthly as [string, string];
---
<Base title="Analyze" description="Time series, anomalies, trends and comparisons of precipitation for Algeria, its 69 wilayas and 1,541 communes, computed from the AEO precipitation product (CHIRPS v3.0).">
  <div class="container-aeo py-8 lg:py-10">
    <header class="max-w-3xl">
      <p class="eyebrow">Analyze</p>
      <h1 class="mt-2 text-[2rem] font-semibold leading-tight text-atlas">Environmental analysis for Algerian areas</h1>
      <p class="mt-3 text-slate">Choose an area, a variable and a period. Every number below is computed in your browser from the published AEO statistics tables — the same files you can download.</p>
    </header>

    <div class="mt-8 grid gap-8 lg:grid-cols-[19rem_1fr]">
      <!-- Controls -->
      <form id="az-form" class="space-y-5 self-start rounded-md border border-line bg-white p-4 lg:sticky lg:top-20" aria-label="Analysis settings" onsubmit="return false">
        <fieldset>
          <legend class="meta uppercase tracking-wider">Area</legend>
          <div class="mt-2 grid grid-cols-3 gap-1 text-[0.85rem]" role="radiogroup">
            <label class="flex cursor-pointer items-center justify-center rounded border border-line px-2 py-1.5 has-[:checked]:border-signal has-[:checked]:bg-[#eef5fc]"><input type="radio" name="level" value="admin0" class="sr-only" />Algeria</label>
            <label class="flex cursor-pointer items-center justify-center rounded border border-line px-2 py-1.5 has-[:checked]:border-signal has-[:checked]:bg-[#eef5fc]"><input type="radio" name="level" value="admin1" class="sr-only" checked />Wilaya</label>
            <label class="flex cursor-pointer items-center justify-center rounded border border-line px-2 py-1.5 has-[:checked]:border-signal has-[:checked]:bg-[#eef5fc]"><input type="radio" name="level" value="admin2" class="sr-only" />Commune</label>
          </div>
          <label class="mt-3 block text-[0.85rem]" id="wilaya-wrap">
            <span class="text-slate">Wilaya</span>
            <select id="az-wilaya" class="mt-1 w-full rounded-md border border-[#b9c7d1] bg-white px-2.5 py-2"></select>
          </label>
          <div class="mt-3 hidden text-[0.85rem]" id="commune-wrap">
            <label for="az-commune-search" class="text-slate">Commune</label>
            <input id="az-commune-search" type="search" placeholder="Search a commune…" autocomplete="off" class="mt-1 w-full rounded-md border border-[#b9c7d1] px-2.5 py-2" />
            <select id="az-commune" size="6" class="mt-1 w-full rounded-md border border-[#b9c7d1] bg-white px-1 py-1 text-[0.85rem]" aria-label="Commune"></select>
            <p class="mt-1 text-[0.75rem] text-slate">Communes are listed within the selected wilaya; searching covers all 1,541.</p>
          </div>
        </fieldset>

        <fieldset>
          <legend class="meta uppercase tracking-wider">Compare with</legend>
          <div class="mt-2 flex gap-1.5">
            <select id="az-compare" class="min-w-0 flex-1 rounded-md border border-[#b9c7d1] bg-white px-2 py-1.5 text-[0.85rem]" aria-label="Area to compare"></select>
            <button type="button" id="az-compare-add" class="btn btn-secondary !px-3 !py-1.5 text-[0.85rem]">Add</button>
          </div>
          <ul id="az-compare-list" class="mt-2 flex flex-wrap gap-1.5"></ul>
          <p class="mt-1 text-[0.75rem] text-slate">Up to 4 areas of the same level.</p>
        </fieldset>

        <label class="block text-[0.85rem]">
          <span class="meta uppercase tracking-wider">Variable</span>
          <select id="az-variable" class="mt-2 w-full rounded-md border border-[#b9c7d1] bg-white px-2.5 py-2">
            <option value="precip">Precipitation (CHIRPS v3.0)</option>
          </select>
          <span class="mt-1 block text-[0.75rem] text-slate">Only variables with processed AEO data are listed. Temperature, drought indices, vegetation and cropland are being added one by one.</span>
        </label>

        <label class="block text-[0.85rem]">
          <span class="meta uppercase tracking-wider">Period type</span>
          <select id="az-agg" class="mt-2 w-full rounded-md border border-[#b9c7d1] bg-white px-2.5 py-2">
            {AGGREGATIONS.map((a) => <option value={a.id}>{a.label}</option>)}
          </select>
        </label>

        <div class="grid grid-cols-2 gap-2 text-[0.85rem]">
          <label><span class="meta uppercase tracking-wider">From</span><select id="az-from" class="mt-2 w-full rounded-md border border-[#b9c7d1] bg-white px-2 py-2"></select></label>
          <label><span class="meta uppercase tracking-wider">To</span><select id="az-to" class="mt-2 w-full rounded-md border border-[#b9c7d1] bg-white px-2 py-2"></select></label>
        </div>
        <p class="text-[0.75rem] leading-snug text-slate">Data: monthly {months[0]} to {months[1]}; complete calendar years {years[0]}–{years[1]}. Normal: 1991–2020.</p>
      </form>

      <!-- Results -->
      <div class="min-w-0 space-y-8" id="az-results" aria-live="polite">
        <div>
          <h2 id="az-title" class="text-xl font-semibold text-atlas">Loading…</h2>
          <p id="az-subtitle" class="mt-1 text-[0.92rem] text-slate"></p>
          <p id="az-support" class="mt-2 hidden rounded-md border border-[#e9d8b4] bg-[#fbf6ea] px-3 py-2 text-[0.85rem] text-[#5f4716]"></p>
        </div>

        <dl id="az-tiles" class="grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-6"></dl>

        <section aria-labelledby="ts-h" class="rounded-md border border-line bg-white p-4">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 id="ts-h" class="font-semibold text-atlas">Time series</h3>
            <div class="flex gap-2 text-[0.8rem]">
              <button type="button" class="link-btn" data-export="ts" data-fmt="svg">SVG</button>
              <button type="button" class="link-btn" data-export="ts" data-fmt="png">PNG</button>
            </div>
          </div>
          <ul id="az-legend" class="mt-2 flex flex-wrap gap-x-4 gap-y-1 text-[0.8rem] text-graphite"></ul>
          <div id="az-ts" class="mt-2"></div>
          <p id="az-trend" class="mt-3 text-[0.9rem] text-graphite"></p>
          <details class="mt-2 text-[0.82rem] text-slate">
            <summary class="cursor-pointer">How the trend is computed</summary>
            <p class="mt-2">Theil–Sen slope (median of all pairwise slopes) with Sen's 95 % confidence interval, and a two-sided Mann–Kendall test with tie correction, on the years in the selected period (at least 8 needed). If the lag-1 autocorrelation of the detrended series is significant, the test variance is inflated following Yue &amp; Wang (2004). A trend is called significant only when p &lt; 0.05. Missing years are skipped, never interpolated. <a href="/docs/method-precipitation/#trends">Method</a></p>
          </details>
        </section>

        <section aria-labelledby="an-h" class="rounded-md border border-line bg-white p-4">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h3 id="an-h" class="font-semibold text-atlas">Anomalies relative to 1991–2020</h3>
            <div class="flex items-center gap-3 text-[0.8rem]">
              <label class="flex items-center gap-1"><input type="radio" name="anom-unit" value="mm" checked class="accent-[#176BBA]" /> mm</label>
              <label class="flex items-center gap-1"><input type="radio" name="anom-unit" value="pct" class="accent-[#176BBA]" /> %</label>
              <button type="button" class="link-btn" data-export="an" data-fmt="svg">SVG</button>
              <button type="button" class="link-btn" data-export="an" data-fmt="png">PNG</button>
            </div>
          </div>
          <p class="mt-1 text-[0.8rem] text-slate"><span class="mr-1 inline-block h-2.5 w-2.5 rounded-sm align-middle" style="background:#2a78d6"></span>wetter than normal · <span class="mr-1 inline-block h-2.5 w-2.5 rounded-sm align-middle" style="background:#d03b3b"></span>drier than normal <span id="az-an-unit-note"></span></p>
          <div id="az-an" class="mt-2"></div>
        </section>

        <section aria-labelledby="map-h" class="rounded-md border border-line bg-white p-4">
          <div class="flex flex-wrap items-center justify-between gap-2">
            <h3 id="map-h" class="font-semibold text-atlas">Map</h3>
            <div class="flex flex-wrap items-center gap-3 text-[0.8rem]">
              <label class="flex items-center gap-1.5">Year <select id="az-map-year" class="rounded border border-line px-1.5 py-1"></select></label>
              <label class="flex items-center gap-1.5">Show <select id="az-map-metric" class="rounded border border-line px-1.5 py-1"><option value="anomaly">anomaly (%)</option><option value="annual">total (mm)</option></select></label>
              <label class="flex items-center gap-1"><input type="checkbox" id="az-map-grid" class="accent-[#176BBA]" /> 5 km grid</label>
            </div>
          </div>
          <p class="mt-1 text-[0.8rem] text-slate">Calendar-year (January–December) values by <span id="az-map-level">wilaya</span>. Click an area to analyse it.</p>
          <div class="relative mt-3 h-[26rem] overflow-hidden rounded border border-line"><div class="absolute inset-0"><div id="az-map" class="h-full w-full bg-[#dfe7ec]" role="region" aria-label="Map of the selected indicator"></div></div></div>
          <div id="az-map-legend" class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-[0.75rem] text-graphite"></div>
        </section>

        <section aria-labelledby="dl-h" class="rounded-md border border-line bg-white p-4">
          <h3 id="dl-h" class="font-semibold text-atlas">Download</h3>
          <ul id="az-downloads" class="mt-3 grid gap-2 text-[0.9rem] sm:grid-cols-2"></ul>
          <p class="mt-3 text-[0.8rem] text-slate">Source: CHIRPS v3.0 (Climate Hazards Center, UC Santa Barbara; doi:10.15780/G2JQ0P; CC BY 4.0), processed by AEO — <a href={PRECIP.datasetPage}>product page</a>, <a href={PRECIP.methodPage}>method</a>.</p>
        </section>

        <details class="rounded-md border border-line bg-white p-4">
          <summary class="cursor-pointer font-semibold text-atlas">Data table</summary>
          <div class="mt-3 max-h-96 overflow-auto"><table id="az-table" class="w-full text-left text-[0.85rem]"></table></div>
        </details>
      </div>
    </div>
  </div>
</Base>

<style>
  .link-btn { color: #176bba; text-decoration: underline; text-underline-offset: 2px; }
  .link-btn:hover { color: #143b56; }
</style>

<script>
  import { initAnalyze } from '../scripts/analyze';
  initAnalyze();
</script>
