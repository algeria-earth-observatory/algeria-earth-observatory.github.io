---
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import DatasetCard from '../../components/DatasetCard.astro';
import { getDatasets } from '../../lib/catalog';
import { DOMAINS } from '../../lib/domains';
import {
  RES_BUCKETS, PERIOD_BUCKETS, COVERAGE, NATURE, STATUS, formatFamilies, accessMode, resolutionBucket, periodBuckets,
} from '../../lib/format';
import { issueUrl } from '../../config/site';

const all = await getDatasets();
const count = (fn: (d: (typeof all)[number]) => boolean) => all.filter(fn).length;

const providers = [...new Set(all.map((d) => d.provider?.name).filter(Boolean) as string[])].sort();
const formats = [...new Set(all.flatMap(formatFamilies))].sort();

type Facet = { key: string; label: string; options: { value: string; label: string; n: number }[] };
const facets: Facet[] = [
  { key: 'domain', label: 'Scientific domain', options: DOMAINS.map((x) => ({ value: x.id, label: x.title, n: count((d) => d.domain.includes(x.id)) })) },
  { key: 'status', label: 'Status', options: (Object.keys(STATUS) as (keyof typeof STATUS)[]).map((k) => ({ value: k, label: STATUS[k].label, n: count((d) => d.status === k) })) },
  { key: 'access', label: 'Access', options: [
    { value: 'direct', label: 'Direct download', n: count((d) => accessMode(d) === 'direct') },
    { value: 'external', label: 'Access at source (portal / login)', n: count((d) => accessMode(d) === 'external') },
  ] },
  { key: 'nature', label: 'Data nature', options: (Object.keys(NATURE) as (keyof typeof NATURE)[]).map((k) => ({ value: k, label: NATURE[k].label, n: count((d) => d.data_nature === k) })) },
  { key: 'res', label: 'Spatial resolution', options: RES_BUCKETS.map((b) => ({ value: b, label: b, n: count((d) => resolutionBucket(d) === b) })) },
  { key: 'period', label: 'Temporal period', options: PERIOD_BUCKETS.map((b) => ({ value: b, label: b, n: count((d) => periodBuckets(d).includes(b)) })) },
  { key: 'coverage', label: 'Geographic coverage', options: Object.entries(COVERAGE).map(([k, v]) => ({ value: k, label: v, n: count((d) => d.spatial_extent?.coverage === k) })) },
  { key: 'format', label: 'File format', options: formats.map((f) => ({ value: f, label: f, n: count((d) => formatFamilies(d).includes(f)) })) },
  { key: 'provider', label: 'Data source', options: providers.map((p) => ({ value: p, label: p, n: count((d) => d.provider?.name === p) })) },
];
---
<Base title="Data catalog" description="Search and filter documented Earth observation and environmental datasets for Algeria: source, licence, coverage, resolution, limitations and access.">
  <PageHeader
    eyebrow="Data catalog"
    title="Find environmental data for Algeria"
    lead="Each record documents the original source, licence, coverage, resolution, scientific limitations and how to access the data. Most datasets are global products held by their providers: AEO links to the source and states when you must extract the Algeria subset yourself."
  />

  <div class="container-aeo py-8 lg:py-10">
    <div class="lg:grid lg:grid-cols-[17rem_1fr] lg:gap-10">
      <!-- Filters -->
      <aside aria-labelledby="filters-title" class="lg:sticky lg:top-20 lg:self-start lg:max-h-[calc(100vh-6rem)] lg:overflow-y-auto lg:pr-2">
        <div class="flex items-center justify-between">
          <h2 id="filters-title" class="text-base font-semibold">Filters</h2>
          <button type="button" id="f-reset" class="text-sm text-signal hover:underline">Clear all</button>
        </div>
        <button type="button" id="f-toggle" class="mt-3 w-full rounded border border-line px-3 py-2 text-left text-sm font-medium text-atlas lg:hidden" aria-expanded="false" aria-controls="f-panel">Show filters</button>
        <form id="f-panel" class="mt-3 hidden space-y-5 lg:block" onsubmit="return false">
          {facets.map((f) => (
            <fieldset class="border-t border-line pt-4">
              <legend class="meta mb-2 uppercase tracking-wider">{f.label}</legend>
              <div class:list={['space-y-1.5', f.key === 'provider' && 'max-h-56 overflow-y-auto pr-1']}>
                {f.options.map((o) => (
                  <label class="flex cursor-pointer items-start gap-2 text-[0.88rem] leading-snug text-graphite">
                    <input type="checkbox" name={f.key} value={o.value} class="mt-0.5 h-4 w-4 shrink-0 accent-[#176BBA]" />
                    <span class="flex-1">{o.label}</span>
                    <span class="meta" data-facet-count={`${f.key}::${o.value}`}>{o.n}</span>
                  </label>
                ))}
              </div>
            </fieldset>
          ))}
        </form>
      </aside>

      <!-- Results -->
      <section aria-labelledby="results-title" class="mt-8 lg:mt-0">
        <h2 id="results-title" class="sr-only">Results</h2>
        <div class="flex flex-col gap-3 sm:flex-row sm:items-end">
          <div class="flex-1">
            <label for="q" class="meta uppercase tracking-wider">Search</label>
            <input id="q" type="search" autocomplete="off" placeholder="e.g. cropland, SPEI, Sentinel-2, soil moisture"
              class="mt-1 w-full rounded-md border border-[#b9c7d1] bg-white px-3.5 py-2.5 text-[0.95rem] focus:border-signal focus:outline-none" />
          </div>
          <div>
            <label for="sort" class="meta uppercase tracking-wider">Sort by</label>
            <select id="sort" class="mt-1 block w-full rounded-md border border-[#b9c7d1] bg-white px-3 py-2.5 text-[0.95rem] sm:w-60">
              <option value="relevance">Default (published first)</option>
              <option value="name">Name (A–Z)</option>
              <option value="published">Publication date (newest)</option>
              <option value="updated">Recently updated</option>
            </select>
          </div>
        </div>
        <p class="mt-4 text-sm text-slate" aria-live="polite" id="result-count">Showing {all.length} of {all.length} records</p>

        <div id="results" class="mt-4 grid gap-4 md:grid-cols-2">
          {all.map((d) => <DatasetCard d={d} />)}
        </div>
        <div id="no-results" class="mt-6 hidden rounded-md border border-dashed border-[#b9c7d1] p-6 text-center text-slate">
          <p class="font-medium text-atlas">No records match these filters.</p>
          <p class="mt-1 text-sm">Clear a filter, or <a href={issueUrl('dataset-proposal.yml')}>propose a dataset</a> that should be here.</p>
        </div>

        <div class="mt-10 grid gap-4 rounded-md bg-paper p-5 text-sm text-slate sm:grid-cols-2">
          <p><strong class="text-atlas">Geographic browsing.</strong> Every current record covers the whole of Algeria. Wilaya-level subsetting and downloads are planned; use the <a href="/map/">map explorer</a> to locate wilayas and inspect layers.</p>
          <p><strong class="text-atlas">Machine-readable.</strong> The full catalog is available as <a href="/catalog.json">JSON</a> and as a static <a href="/stac/catalog.json">STAC catalog</a>. Each record also has its own JSON and STAC file.</p>
        </div>
      </section>
    </div>
  </div>
</Base>

<script>
  import { initCatalog } from '../../scripts/catalog';
  initCatalog();
</script>
