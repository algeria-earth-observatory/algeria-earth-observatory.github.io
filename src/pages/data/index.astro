---
import Base from '../../layouts/Base.astro';
import { getDatasets } from '../../lib/catalog';
import { domainById, THEMATIC_DOMAINS } from '../../lib/domains';
import { STATUS, period, fmtDate, humanBytes } from '../../lib/format';

const all = await getDatasets();
const rows = all.filter((d) => d.origin !== 'external');
const nSources = all.filter((d) => d.origin === 'external').length;
const LEVEL: Record<string, string> = { admin0: 'Algeria', admin1: 'Wilayas', admin2: 'Communes' };
const short = (name = '') => { const m = name.match(/\(([^)]*)\)/); return m && !/source|processing/i.test(m[1]) ? m[1] : name.split('(')[0].split(';')[0].trim(); };
const res = (d: (typeof all)[number]) => (d.resolution?.spatial ?? '—').split(';')[0].replace(/\s*\(.*\)$/, '');
const levels = (d: (typeof all)[number]) => (d.product ? d.product.levels.map((l) => LEVEL[l]).join(' · ') : d.status === 'in-preparation' ? '—' : 'Algeria · Wilayas · Communes');
const size = (d: (typeof all)[number]) => d.access.filter((a) => a.kind === 'download' && a.size_bytes).reduce((s, a) => s + (a.size_bytes ?? 0), 0);
const avail = (d: (typeof all)[number]) => (d.status === 'in-preparation' ? 'planned' : 'available');
const start = (d: (typeof all)[number]) => d.temporal_extent?.start?.slice(0, 4) ?? '';
const label = 'font-mono text-[0.72rem] uppercase tracking-[0.06em] text-slate';
---
<Base title="Data" description="Algeria-ready environmental data products: precipitation, drought index SPEI and administrative boundaries for Algeria, its wilayas and communes, with versions, checksums and code.">
  <section class="mx-auto max-w-[90rem] px-5 pb-8 pt-12 sm:px-8 lg:px-12 lg:pt-16">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="overline">Data</p>
        <h1 class="h-section mt-4 !text-[clamp(2.1rem,3.6vw,3rem)]">Algeria-ready products</h1>
      </div>
      <p class="text-[1rem] leading-relaxed text-slate lg:col-span-5">Processed by AEO for Algeria and its administrative units, each with a version, checksums, provenance and code. Upstream inputs are documented in the <a href="/data/sources/">source library</a>.</p>
    </div>
  </section>

  <section class="mx-auto max-w-[90rem] px-5 sm:px-8 lg:px-12" aria-labelledby="idx-h">
    <h2 id="idx-h" class="sr-only">Product index</h2>
    <form id="cat-controls" class="flex flex-wrap items-end gap-x-6 gap-y-3 border-y border-line py-4 text-[0.875rem]" onsubmit="return false" aria-label="Filter and sort products">
      <label class="min-w-[14rem] flex-1"><span class={label}>Search</span>
        <input id="cat-q" type="search" placeholder="Product, variable, source" class="field mt-1.5" /></label>
      <fieldset><legend class={label}>Availability</legend>
        <div class="mt-1.5 flex border border-line-strong" style="border-radius:var(--radius-control)">
          {[['all', 'All'], ['available', 'Available'], ['planned', 'Planned']].map(([v, t], i) => (
            <label class="flex min-h-9 cursor-pointer items-center border-r border-line-strong px-3 last:border-r-0 has-[:checked]:bg-midnight has-[:checked]:text-white"><input type="radio" name="cat-avail" value={v} class="sr-only" checked={i === 0} />{t}</label>
          ))}
        </div></fieldset>
      <label><span class={label}>Domain</span>
        <select id="cat-domain" class="field mt-1.5 min-h-9"><option value="">All domains</option>{THEMATIC_DOMAINS.map((d) => <option value={d.id}>{d.title}</option>)}</select></label>
      <label><span class={label}>Sort</span>
        <select id="cat-sort" class="field mt-1.5 min-h-9"><option value="default">Available first</option><option value="name">Name (A–Z)</option><option value="start">Period start</option><option value="updated">Recently updated</option></select></label>
      <p id="cat-count" class="tabular ml-auto font-mono text-[0.75rem] text-slate" aria-live="polite">{rows.length} products</p>
    </form>

    <div class="hidden grid-cols-12 gap-4 border-b border-midnight pb-3 pt-6 lg:grid" aria-hidden="true">
      <span class:list={[label, 'col-span-4']}>Product</span><span class:list={[label, 'col-span-2']}>Period</span><span class:list={[label, 'col-span-2']}>Resolution</span>
      <span class:list={[label, 'col-span-2']}>Geographic level</span><span class:list={[label, 'col-span-1']}>Availability</span><span class:list={[label, 'col-span-1 text-right']}>Download</span>
    </div>
    <ul id="cat-list">
      {rows.map((d, i) => (
        <li class="border-b border-line" data-avail={avail(d)} data-domain={d.domain.join('|')} data-name={d.title.toLowerCase()} data-start={start(d)}
          data-updated={d.updated_date ?? d.published_date ?? ''} data-order={i} data-search={`${d.title} ${d.description} ${d.keywords.join(' ')} ${d.provider?.name ?? ''}`.toLowerCase()}>
          <div class="grid gap-x-4 gap-y-2 py-6 lg:grid-cols-12 lg:items-baseline">
            <div class="lg:col-span-4">
              <a href={`/data/${d.id}/`} class:list={['text-[1.0625rem] font-medium leading-snug no-underline hover:text-cobalt', d.status === 'in-preparation' ? 'text-graphite' : 'text-atlas']}>{d.title.split(':')[0]}</a>
              <p class="mt-1.5 max-w-md text-[0.875rem] leading-relaxed text-slate">{d.description.split('. ')[0].replace(/\.$/, '')}.</p>
              {d.status !== 'in-preparation' && <p class="meta mt-2 !text-[0.72rem]">{short(d.provider?.name)} · {d.domain.map((x) => domainById(x)?.short).join(', ')}</p>}
            </div>
            <p class="tabular font-mono text-[0.8125rem] text-graphite lg:col-span-2"><span class="text-slate lg:hidden">Period </span>{d.status === 'in-preparation' ? '—' : period(d)}</p>
            <p class="font-mono text-[0.8125rem] text-graphite lg:col-span-2"><span class="text-slate lg:hidden">Resolution </span>{d.status === 'in-preparation' ? '—' : res(d)}</p>
            <p class="text-[0.875rem] text-graphite lg:col-span-2">{levels(d)}</p>
            <p class="lg:col-span-1"><span class:list={['status', STATUS[d.status].cls]} title={STATUS[d.status].help}>{STATUS[d.status].label}</span></p>
            <p class="lg:col-span-1 lg:text-right">
              {d.status === 'in-preparation'
                ? <span class="text-[0.8125rem] text-slate">Not released</span>
                : <a href={`/data/${d.id}/#access`} class="btn btn-primary !px-3 !py-1.5 !text-[0.8125rem]">Download</a>}
            </p>
          </div>
          {d.status !== 'in-preparation' && (
            <details class="group pb-5 text-[0.875rem]">
              <summary class="inline-flex min-h-6 cursor-pointer list-none items-center font-mono text-[0.75rem] text-slate hover:text-atlas"><span class="group-open:hidden">+ Technical details</span><span class="hidden group-open:inline">− Technical details</span></summary>
              <dl class="tabular mt-4 grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-4">
                <div><dt class="meta">Identifier</dt><dd class="mt-0.5 font-mono text-[0.8125rem] text-atlas">{d.id}</dd></div>
                <div><dt class="meta">Version</dt><dd class="mt-0.5 font-mono text-[0.8125rem] text-atlas">{d.product?.product_version ?? d.version}</dd></div>
                <div><dt class="meta">Formats</dt><dd class="mt-0.5 text-atlas">{d.format.join(', ')}</dd></div>
                <div><dt class="meta">Licence</dt><dd class="mt-0.5 text-atlas">{d.license?.spdx ?? d.license?.name}</dd></div>
                <div><dt class="meta">CRS</dt><dd class="mt-0.5 font-mono text-[0.8125rem] text-atlas">{d.crs}</dd></div>
                <div><dt class="meta">Listed files</dt><dd class="mt-0.5 text-atlas">{humanBytes(size(d)) ?? '—'}</dd></div>
                <div><dt class="meta">Updated</dt><dd class="mt-0.5 text-atlas">{fmtDate(d.updated_date ?? d.published_date)}</dd></div>
                <div><dt class="meta">Links</dt><dd class="mt-0.5 flex flex-wrap gap-x-3">
                  {d.product && <a href={d.product.manifest}>Manifest</a>}
                  <a href={`/data/${d.id}.stac.json`}>STAC</a>
                  {d.product?.analyze && <a href={`/analyze/?var=${d.product.variables.includes('spei') ? 'spei' : 'precip'}`}>Analyze</a>}
                  {d.map_layers.length > 0 && <a href={`/map/?layers=${d.map_layers[0]}`}>Map</a>}
                </dd></div>
              </dl>
            </details>
          )}
        </li>
      ))}
    </ul>
    <p id="cat-empty" class="hidden py-10 text-center text-slate">No product matches these filters.</p>
  </section>

  <section class="mx-auto max-w-[90rem] px-5 pb-[var(--space-section)] pt-16 sm:px-8 lg:px-12">
    <div class="grid gap-6 border-t border-line pt-8 lg:grid-cols-12">
      <h2 class="h-sub lg:col-span-4">Source library</h2>
      <p class="text-[1rem] text-slate lg:col-span-8">{nSources} upstream datasets — global and regional products held by their providers — documented with licence, coverage and limitations. They are inputs, not Algeria-ready downloads. <a href="/data/sources/" class="link-arrow">Open the source library</a></p>
    </div>
  </section>
</Base>

<script>
  const list = document.getElementById('cat-list')!;
  const items = [...list.querySelectorAll<HTMLLIElement>('li[data-avail]')];
  const q = document.getElementById('cat-q') as HTMLInputElement;
  const dom = document.getElementById('cat-domain') as HTMLSelectElement;
  const sort = document.getElementById('cat-sort') as HTMLSelectElement;
  const count = document.getElementById('cat-count')!;
  const empty = document.getElementById('cat-empty')!;
  const params = new URLSearchParams(location.search);
  if (params.get('q')) q.value = params.get('q')!;
  if (params.get('domain')) dom.value = params.get('domain')!;
  function apply() {
    const avail = (document.querySelector('input[name="cat-avail"]:checked') as HTMLInputElement).value;
    const text = q.value.trim().toLowerCase();
    let n = 0;
    for (const li of items) {
      const ok = (avail === 'all' || li.dataset.avail === avail) && (!dom.value || li.dataset.domain!.split('|').includes(dom.value)) && (!text || li.dataset.search!.includes(text));
      li.hidden = !ok;
      if (ok) n++;
    }
    const key = sort.value;
    const sorted = [...items].sort((a, b) => key === 'name' ? a.dataset.name!.localeCompare(b.dataset.name!)
      : key === 'start' ? (a.dataset.start || '9999').localeCompare(b.dataset.start || '9999')
      : key === 'updated' ? (b.dataset.updated || '').localeCompare(a.dataset.updated || '')
      : (a.dataset.avail === b.dataset.avail ? Number(a.dataset.order) - Number(b.dataset.order) : a.dataset.avail === 'available' ? -1 : 1));
    sorted.forEach((li) => list.appendChild(li));
    count.textContent = `${n} of ${items.length} products`;
    empty.classList.toggle('hidden', n > 0);
  }
  document.getElementById('cat-controls')!.addEventListener('input', apply);
  document.getElementById('cat-controls')!.addEventListener('change', apply);
  apply();
</script>
