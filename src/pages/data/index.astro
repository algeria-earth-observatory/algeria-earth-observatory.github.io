---
import Base from '../../layouts/Base.astro';
import RegionDataDownloader from '../../components/RegionDataDownloader.astro';
import { getDatasets } from '../../lib/catalog';
import { domainById, THEMATIC_DOMAINS } from '../../lib/domains';
import { STATUS, period, fmtDate } from '../../lib/format';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';

const all = await getDatasets();
const aeo = all.filter((d) => d.origin !== 'external');
const available = aeo.filter((d) => d.status === 'available');
const planned = aeo.filter((d) => d.status === 'in-preparation');
const nSources = all.filter((d) => d.origin === 'external').length;
type D = (typeof all)[number];
const LEVEL: Record<string, string> = { admin0: 'Algeria', admin1: 'Wilayas', admin2: 'Communes' };
const FMT: Record<string, string> = { COG: 'GeoTIFF', CSV: 'CSV', PARQUET: 'Parquet' };
const manifestOf = (d: D) => (d.product ? JSON.parse(readFileSync(join(process.cwd(), 'public', d.product.manifest), 'utf-8')) : null);
const short = (name = '') => { const m = name.match(/\(([^)]*)\)/); return m && !/source|processing/i.test(m[1]) ? m[1] : name.split('(')[0].split(';')[0].trim(); };
const levels = (d: D) => { const m = manifestOf(d); return m ? m.available_levels.map((l: string) => LEVEL[l]).join(', ') : 'Algeria, Wilayas, Communes'; };
const formats = (d: D) => { const m = manifestOf(d); return m ? m.formats.map((f: string) => FMT[f] ?? f).join(', ') : [...new Set(d.format.map((f) => f.split(' ')[0]))].join(', '); };
const RDD: Record<string, string> = { 'aeo-dza-precipitation-chirps3': 'precip', 'aeo-dza-spei-terraclimate': 'spei', 'aeo-dza-admin-boundaries': 'boundaries' };
const search = (d: D) => `${d.title} ${d.description} ${d.keywords.join(' ')} ${d.provider?.name ?? ''}`.toLowerCase();
const cols = 'lg:grid-cols-[minmax(0,3.2fr)_minmax(0,1.4fr)_minmax(0,1.8fr)_minmax(0,1.6fr)_minmax(9.5rem,auto)]';
const cellLabel = 'text-[0.875rem] text-slate lg:sr-only';
---
<Base title="Data" description="Algeria-ready environmental data products: precipitation, drought index SPEI and administrative boundaries for Algeria, its wilayas and communes, with versions, checksums and code.">
  <section class="mx-auto max-w-[90rem] px-5 pb-6 pt-12 sm:px-8 lg:px-12 lg:pt-16">
    <div class="grid gap-6 lg:grid-cols-12 lg:items-end">
      <div class="lg:col-span-7">
        <p class="overline">Data</p>
        <h1 class="h-section mt-4 !text-[clamp(2.1rem,3.6vw,3rem)]">Algeria-ready products</h1>
      </div>
      <p class="text-[1rem] leading-relaxed text-slate lg:col-span-5">Data processed by AEO for Algeria, its wilayas and communes. Each product has a version, checksums and the code that made it.</p>
    </div>
  </section>

  <section class="mx-auto max-w-[90rem] px-5 sm:px-8 lg:px-12" aria-labelledby="avail-h">
    <form id="cat-controls" class="flex flex-wrap items-end gap-x-6 gap-y-4 border-y border-line py-5" onsubmit="return false" aria-label="Filter and sort products">
      <label class="relative min-w-[min(100%,16rem)] flex-1"><span class="block text-[0.875rem] font-medium text-atlas">Search products</span>
        <svg class="pointer-events-none absolute bottom-[0.85rem] left-3 h-4 w-4 text-slate" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="11" cy="11" r="6.5" /><path d="M16 16l4.5 4.5" /></svg>
        <input id="cat-q" type="search" placeholder="For example: rainfall, drought, wilaya" class="field mt-1.5 !min-h-11 !pl-9 !text-[1rem]" /></label>
      <label><span class="block text-[0.875rem] font-medium text-atlas">Sort</span>
        <select id="cat-sort" class="field mt-1.5 !min-h-11"><option value="default">Recommended</option><option value="name">Name (A–Z)</option><option value="start">Period start</option><option value="updated">Recently updated</option></select></label>
      <fieldset class="basis-full"><legend class="text-[0.875rem] font-medium text-atlas">Environmental domain</legend>
        <div class="mt-1.5 flex flex-wrap gap-2">
          {[{ id: '', short: 'All' }, ...THEMATIC_DOMAINS].map((d, i) => (
            <label class="flex min-h-10 cursor-pointer items-center border border-line-strong bg-surface px-3.5 text-[0.9375rem] has-[:checked]:border-midnight has-[:checked]:bg-midnight has-[:checked]:text-white has-[:focus-visible]:outline has-[:focus-visible]:outline-2 has-[:focus-visible]:outline-offset-2 has-[:focus-visible]:outline-cobalt" style="border-radius:var(--radius-control)"><input type="radio" name="cat-domain" value={d.id} class="sr-only" checked={i === 0} />{d.short}</label>
          ))}
        </div></fieldset>
    </form>
    <p id="cat-count" class="sr-only" aria-live="polite"></p>

    <div class="mt-10 flex flex-wrap items-baseline justify-between gap-3">
      <h2 id="avail-h" class="h-sub">Available now <span class="tabular text-slate" id="avail-n">({available.length})</span></h2>
      <p class="text-[0.9375rem] text-slate">Download opens the download assistant below with the product selected.</p>
    </div>
    <div class:list={['mt-4 hidden gap-4 border-b border-midnight pb-3 text-[0.875rem] font-medium text-slate lg:grid', cols]} aria-hidden="true">
      <span>Product</span><span>Time period</span><span>Geographic levels</span><span>Formats</span><span class="text-right">Download</span>
    </div>
    <ul id="cat-list" class="border-t border-midnight lg:border-t-0" aria-labelledby="avail-h">
      {available.map((d, i) => (
        <li class="border-b border-line" data-domain={d.domain.join('|')} data-name={d.title.toLowerCase()} data-start={d.temporal_extent?.start?.slice(0, 4) ?? ''}
          data-updated={d.updated_date ?? d.published_date ?? ''} data-order={i} data-search={search(d)}>
          <div class:list={['grid gap-x-4 gap-y-2 py-6 lg:items-baseline', cols]}>
            <div>
              <h3 class="text-[1.125rem] font-medium leading-snug"><a href={`/data/${d.id}/`} class="text-atlas no-underline hover:text-cobalt hover:underline">{d.title.split(':')[0]}</a></h3>
              <p class="mt-1.5 max-w-xl text-[0.9375rem] leading-relaxed text-slate">{d.description.split('. ')[0].replace(/\.$/, '')}.</p>
              <p class="mt-2 flex flex-wrap items-center gap-2 text-[0.875rem] text-slate"><span class:list={['status', STATUS[d.status].cls]}>{STATUS[d.status].label}</span>{short(d.provider?.name)} · {d.domain.map((x) => domainById(x)?.short).join(', ')}</p>
            </div>
            <p class="tabular text-[0.9375rem] text-graphite"><span class={cellLabel}>Time period: </span>{period(d)}</p>
            <p class="text-[0.9375rem] text-graphite"><span class={cellLabel}>Geographic levels: </span>{levels(d)}</p>
            <p class="text-[0.9375rem] text-graphite"><span class={cellLabel}>Formats: </span>{formats(d)}</p>
            <p class="pt-2 lg:pt-0 lg:text-right">
              {RDD[d.id]
                ? <button type="button" class="btn btn-primary" data-rdd-open={RDD[d.id]}><svg class="icon-download" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 4v11M7 10l5 5 5-5M5 20h14" /></svg>Download<span class="sr-only"> {d.title.split(':')[0]}</span></button>
                : <a href={`/data/${d.id}/#access`} class="btn btn-primary">Download<span class="sr-only"> {d.title.split(':')[0]}</span></a>}
            </p>
          </div>
          <details class="pb-5 text-[0.9375rem]">
            <summary class="min-h-6 cursor-pointer text-[0.875rem] text-slate hover:text-atlas">Technical details</summary>
            <dl class="tabular mt-3 grid gap-x-8 gap-y-3 sm:grid-cols-2 lg:grid-cols-4">
              <div><dt class="text-[0.875rem] text-slate">Identifier</dt><dd class="mt-0.5 font-mono text-[0.875rem] text-atlas">{d.id}</dd></div>
              <div><dt class="text-[0.875rem] text-slate">Version</dt><dd class="mt-0.5 font-mono text-[0.875rem] text-atlas">{d.product?.product_version ?? d.version}</dd></div>
              <div><dt class="text-[0.875rem] text-slate">Licence</dt><dd class="mt-0.5 text-atlas">{d.license?.spdx ?? d.license?.name}</dd></div>
              <div><dt class="text-[0.875rem] text-slate">Updated</dt><dd class="mt-0.5 text-atlas">{fmtDate(d.updated_date ?? d.published_date)}</dd></div>
              <div><dt class="text-[0.875rem] text-slate">Coordinate system</dt><dd class="mt-0.5 font-mono text-[0.875rem] text-atlas">{d.crs}</dd></div>
              <div class="sm:col-span-3"><dt class="text-[0.875rem] text-slate">Metadata</dt><dd class="mt-0.5 flex flex-wrap gap-x-4">
                <a href={`/data/${d.id}/`}>Product page</a>
                {d.product && <a href={d.product.manifest}>Manifest (all files, checksums)</a>}
                <a href={`/data/${d.id}.stac.json`}>STAC</a>
                {d.map_layers.length > 0 && <a href={`/map/?layers=${d.map_layers[0]}`}>Map</a>}
              </dd></div>
            </dl>
          </details>
        </li>
      ))}
    </ul>
    <p id="cat-empty" class="hidden py-8 text-[1rem] text-slate">No available product matches these filters.</p>
  </section>

  <div class="mt-12 border-y border-line bg-surface">
    <div class="mx-auto max-w-[90rem] px-5 py-12 sm:px-8 lg:px-12">
      <RegionDataDownloader />
    </div>
  </div>

  <section id="planned" class="mx-auto max-w-[90rem] scroll-mt-20 px-5 pt-14 sm:px-8 lg:px-12" aria-labelledby="planned-h">
    <h2 id="planned-h" class="h-sub">Planned <span class="tabular text-slate" id="planned-n">({planned.length})</span></h2>
    <p class="mt-2 max-w-3xl text-[0.9375rem] text-slate">These AEO products are in preparation. They have no data or downloads yet and will appear under “Available now” only when published.</p>
    <ul id="planned-list" class="mt-4 grid gap-x-10 border-t border-line md:grid-cols-2">
      {planned.map((d) => (
        <li class="border-b border-line py-4" data-domain={d.domain.join('|')} data-search={search(d)}>
          <p class="flex flex-wrap items-center gap-2"><a href={`/data/${d.id}/`} class="font-medium text-atlas">{d.title.split(':')[0]}</a><span class:list={['status', STATUS[d.status].cls]}>{STATUS[d.status].label}</span></p>
          <p class="mt-1 text-[0.9375rem] leading-relaxed text-slate">{d.description.split('. ')[0].replace(/\.$/, '')}.</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="mx-auto max-w-[90rem] px-5 pb-[var(--space-section)] pt-14 sm:px-8 lg:px-12" aria-labelledby="src-h">
    <div class="grid gap-4 border-t border-line pt-6 lg:grid-cols-12">
      <h2 id="src-h" class="text-[1.0625rem] font-medium text-atlas lg:col-span-4">Source library</h2>
      <p class="text-[0.9375rem] text-slate lg:col-span-8">{nSources} upstream datasets (global and regional products held by their providers) are documented as inputs, with licence and coverage. They are not Algeria-ready downloads. <a href="/data/sources/">Open the source library</a>.</p>
    </div>
  </section>
</Base>

<script>
  const list = document.getElementById('cat-list')!;
  const items = [...list.querySelectorAll<HTMLLIElement>('li[data-search]')];
  const plannedItems = [...document.querySelectorAll<HTMLLIElement>('#planned-list li')];
  const q = document.getElementById('cat-q') as HTMLInputElement;
  const domVal = () => (document.querySelector('input[name="cat-domain"]:checked') as HTMLInputElement).value;
  const sort = document.getElementById('cat-sort') as HTMLSelectElement;
  const params = new URLSearchParams(location.search);
  if (params.get('q')) q.value = params.get('q')!;
  if (params.get('domain')) { const r = document.querySelector<HTMLInputElement>(`input[name="cat-domain"][value="${CSS.escape(params.get('domain')!)}"]`); if (r) r.checked = true; }
  const match = (li: HTMLElement, text: string) => (!domVal() || li.dataset.domain!.split('|').includes(domVal())) && (!text || li.dataset.search!.includes(text));
  function apply() {
    const text = q.value.trim().toLowerCase();
    let n = 0, m = 0;
    for (const li of items) { li.hidden = !match(li, text); if (!li.hidden) n++; }
    for (const li of plannedItems) { li.hidden = !match(li, text); if (!li.hidden) m++; }
    const key = sort.value;
    [...items].sort((a, b) => key === 'name' ? a.dataset.name!.localeCompare(b.dataset.name!)
      : key === 'start' ? (a.dataset.start || '9999').localeCompare(b.dataset.start || '9999')
      : key === 'updated' ? (b.dataset.updated || '').localeCompare(a.dataset.updated || '')
      : Number(a.dataset.order) - Number(b.dataset.order)).forEach((li) => list.appendChild(li));
    document.getElementById('avail-n')!.textContent = `(${n})`;
    document.getElementById('planned-n')!.textContent = `(${m})`;
    document.getElementById('cat-count')!.textContent = `${n} available and ${m} planned products match.`;
    document.getElementById('cat-empty')!.classList.toggle('hidden', n > 0);
  }
  document.getElementById('cat-controls')!.addEventListener('input', apply);
  document.getElementById('cat-controls')!.addEventListener('change', apply);
  apply();
  document.querySelectorAll<HTMLButtonElement>('[data-rdd-open]').forEach((b) => b.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('aeo:rdd-set', { detail: { indicator: b.dataset.rddOpen, focus: true } }));
  }));
</script>
