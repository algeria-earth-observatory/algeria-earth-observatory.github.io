---
import Base from '../../layouts/Base.astro';
import Badges from '../../components/Badges.astro';
import { getDatasets } from '../../lib/catalog';
import { domainById } from '../../lib/domains';
import { period, fmtDate } from '../../lib/format';

const all = await getDatasets();
const products = all.filter((d) => d.origin !== 'external' && d.status !== 'in-preparation');
const planned = all.filter((d) => d.status === 'in-preparation');
const nSources = all.filter((d) => d.origin === 'external').length;
const LEVEL: Record<string, string> = { admin0: 'Algeria', admin1: '69 wilayas', admin2: '1,541 communes' };
const shortSource = (name = '') => { const m = name.match(/\(([^)]*)\)/); return m && !/source|processing/i.test(m[1]) ? m[1] : name.split('(')[0].split(';')[0].trim(); };
---
<Base title="Data" description="Algeria-ready environmental data products: precipitation, drought index SPEI, administrative boundaries and more — prepared for Algeria, its wilayas and communes, with checksums and reproducible code.">
  <section class="eo-grid border-b border-line bg-paper">
    <div class="container-aeo py-12">
      <p class="eo-readout"><span class="eo-dot mr-2 align-middle"></span>Algeria-ready data</p>
      <h1 class="mt-3 text-[2.2rem] font-semibold leading-tight text-atlas">Prepared for Algeria. Ready to download.</h1>
      <p class="mt-3 max-w-3xl text-graphite">Every product below is processed by AEO for Algeria and its administrative units: national grids, wilaya subsets and commune statistics, each with a version, checksums, provenance and the code that produced it.</p>
      <div class="mt-6 flex flex-wrap gap-3 text-[0.9rem]">
        <a href="/analyze/" class="btn btn-primary">Analyze</a>
        <a href="/map/" class="btn btn-secondary">Open the map</a>
        <a href="/data/sources/" class="btn btn-secondary">Source library ({nSources})</a>
      </div>
    </div>
  </section>

  <section class="container-aeo py-10" aria-labelledby="p-h">
    <h2 id="p-h" class="sr-only">Products</h2>
    <div class="grid gap-5 lg:grid-cols-2">
      {products.map((d) => (
        <article class="card eo-tick relative flex flex-col p-6">
          <div class="flex items-start justify-between gap-3">
            <Badges d={d} />
            <span class="eo-readout">{d.domain.map((x) => domainById(x)?.short).join(' · ')}</span>
          </div>
          <h3 class="mt-3 text-xl font-semibold leading-snug"><a href={`/data/${d.id}/`} class="text-atlas no-underline hover:text-signal">{d.title}</a></h3>
          <p class="mt-2 text-[0.93rem] text-graphite">{d.description}</p>
          <dl class="mt-5 grid grid-cols-2 gap-x-6 gap-y-3 border-t border-line pt-4 font-mono text-[0.78rem] sm:grid-cols-4">
            <div><dt class="text-slate">SOURCE</dt><dd class="text-atlas">{shortSource(d.provider?.name)}</dd></div>
            <div><dt class="text-slate">RESOLUTION</dt><dd class="text-atlas">{d.resolution?.spatial?.split(';')[0] ?? '—'}</dd></div>
            <div><dt class="text-slate">PERIOD</dt><dd class="text-atlas">{period(d)}</dd></div>
            <div><dt class="text-slate">VERSION</dt><dd class="text-atlas">{d.product?.product_version ?? d.version}</dd></div>
            <div class="col-span-2"><dt class="text-slate">LEVELS</dt><dd class="text-atlas">{d.product ? d.product.levels.map((l) => LEVEL[l]).join(' · ') : 'Algeria · wilayas · communes'}</dd></div>
            <div class="col-span-2"><dt class="text-slate">FORMATS</dt><dd class="text-atlas">{d.format.join(' · ')}</dd></div>
          </dl>
          <div class="mt-5 flex flex-wrap gap-2">
            <a href={`/data/${d.id}/#access`} class="btn btn-primary !py-2 text-[0.88rem]">Download</a>
            {d.product?.analyze && <a href={`/analyze/?var=${d.product.variables.includes('spei') ? 'spei' : 'precip'}`} class="btn btn-secondary !py-2 text-[0.88rem]">Analyze</a>}
            {d.map_layers.length > 0 && <a href={`/map/?layers=${d.map_layers[0]}`} class="btn btn-secondary !py-2 text-[0.88rem]">Map</a>}
          </div>
          <p class="meta mt-3">Updated {fmtDate(d.updated_date ?? d.published_date)}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="border-t border-line bg-paper" aria-labelledby="pl-h">
    <div class="container-aeo py-10">
      <h2 id="pl-h" class="text-xl font-semibold text-atlas">Planned products</h2>
      <p class="mt-1 text-[0.92rem] text-slate">Announced, not released: no data exist for these yet.</p>
      <ul class="mt-4 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {planned.map((d) => <li class="card p-4"><a href={`/data/${d.id}/`} class="font-medium">{d.title}</a><p class="mt-1 text-[0.85rem] text-slate">{d.description.split('. ')[0]}.</p></li>)}
      </ul>
      <p class="mt-6 text-[0.92rem]"><a href="/data/sources/">Source library →</a> <span class="text-slate">{nSources} upstream datasets documented with licence, coverage and limitations.</span></p>
    </div>
  </section>
</Base>
