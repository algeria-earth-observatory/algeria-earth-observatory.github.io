---
/**
 * Explore: one map, one primary indicator at a time, and the RegionInspector beside it.
 * Find a place → choose an indicator → read the regional statistics → download or visit the source.
 */
import Base from '../layouts/Base.astro';
import { MAP_LAYERS, BASEMAPS } from '../data/map-layers';
import { PRIMARY_DOMAINS } from '../lib/domains';
import { getDatasets } from '../lib/catalog';
import { indicatorsFromRecords } from '../lib/region-download.js';
import { hasAeoStats } from '../scripts/region-inspector';

const datasets = await getDatasets();
const byId = new Map(datasets.map((d) => [d.id, d]));
const missing = MAP_LAYERS.filter((l) => l.dataset && !byId.has(l.dataset));
if (missing.length) throw new Error(`Map layers reference unknown datasets: ${missing.map((l) => `${l.id}→${l.dataset}`).join(', ')}`);

// Explore groups: the five primary domains; dust is shown with climate.
const groupOf = (d: string) => (d === 'hazards' ? 'climate-drought' : d);
const indicators = MAP_LAYERS.filter((l) => l.id !== 'wilayas' && l.id !== 'communes');
const groups = [
  ...PRIMARY_DOMAINS.map((d) => ({ id: d.id as string, title: d.title, layers: indicators.filter((l) => groupOf(l.domain) === d.id) })),
  { id: 'reference', title: 'Satellite imagery', layers: indicators.filter((l) => l.domain === 'reference') },
].filter((g) => g.layers.length);
const shortTitle = (t: string) => t.replace(/\s*\((AEO|SoilGrids 2\.0)[^)]*\)/g, '').replace(/\s*\(AEO\)/, '');
const nature: Record<string, string> = { observed: 'observed', derived: 'derived', modeled: 'model', reference: 'reference' };

const layerInfo = MAP_LAYERS.map((l) => ({ id: l.id, title: l.title, dataset: l.dataset, nature: l.nature, caveat: l.caveat }));
const datasetInfo = Object.fromEntries(MAP_LAYERS.filter((l) => l.dataset).map((l) => {
  const d = byId.get(l.dataset!)!;
  return [d.id, { title: d.title, provider: d.provider?.name, source_url: d.source_url, documentation_url: d.documentation_url, status: d.status, resolution: d.resolution?.spatial }];
}));
const { available } = indicatorsFromRecords(datasets);
const lab = 'block text-[0.875rem] font-medium text-atlas';
---
<Base title="Explore" description="Explore Algeria on an interactive map: choose a wilaya or commune and an environmental indicator (precipitation, drought, soil, vegetation, water) and read its regional statistics." noFooter>
  <div id="explore" data-inspector="closed" class="ex-grid theme-light bg-limestone">
    <!-- Left: data selection -->
    <aside id="ex-panel" aria-label="Data selection" class="ex-panel border-line bg-surface lg:border-r">
      <div class="space-y-6 p-4 lg:p-5">
        <div>
          <h1 class="text-[1.375rem] font-medium leading-tight text-atlas">Explore Algeria</h1>
          <p class="mt-1 text-[0.9375rem] leading-relaxed text-slate">Find a place, choose an indicator, read its statistics.</p>
        </div>

        <div>
          <label for="ex-wilaya" class={lab}>Place</label>
          <p id="ex-wilaya-help" class="mt-0.5 text-[0.8125rem] text-slate">Search a wilaya by name or code, or click it on the map.</p>
          <div class="relative mt-1.5">
            <input id="ex-wilaya" class="field rdd-input" type="text" aria-describedby="ex-wilaya-help" placeholder="Search 69 wilayas" />
            <svg class="rdd-chev" viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" /></svg>
            <ul id="ex-wilaya-list" class="rdd-list" hidden aria-label="Wilayas"></ul>
          </div>
          <label class="mt-2 flex min-h-6 items-center gap-2 text-[0.875rem] text-graphite"><input type="checkbox" id="ex-communes" class="h-4 w-4 accent-[#3458d4]" /> Show communes (click one to select it)</label>
        </div>

        <div>
          <label for="ex-domain" class={lab}>Environmental domain</label>
          <select id="ex-domain" class="field mt-1.5">
            <option value="">All domains</option>
            {groups.map((g) => <option value={g.id}>{g.title}</option>)}
          </select>
        </div>

        <fieldset>
          <legend class={lab}>Indicator</legend>
          <p class="mt-0.5 text-[0.8125rem] text-slate">One layer at a time. <span class="ex-badge ex-badge-aeo">AEO statistics</span> means regional values are available.</p>
          <div id="ex-indicators" class="mt-2 space-y-1">
            <label class="ex-ind" data-group=""><input type="radio" name="ex-ind" value="" class="accent-[#3458d4]" /><span><span class="block text-[0.9375rem] text-atlas">Boundaries only</span></span></label>
            {groups.map((g) => (
              <div data-group-wrap={g.id}>
                <p class="mt-3 text-[0.8125rem] font-medium text-slate">{g.title}</p>
                {g.layers.map((l) => (
                  <label class="ex-ind" data-group={g.id} data-layer={l.id}>
                    <input type="radio" name="ex-ind" value={l.id} class="accent-[#3458d4]" />
                    <span>
                      <span class="block text-[0.9375rem] leading-snug text-atlas">{shortTitle(l.title)}</span>
                      <span class="mt-0.5 flex flex-wrap items-center gap-1.5 text-[0.8125rem] text-slate">
                        {hasAeoStats(l.id) ? <span class="ex-badge ex-badge-aeo">AEO statistics</span> : <span class="ex-badge">Map only</span>}
                        <span>{nature[l.nature]}</span>
                      </span>
                    </span>
                  </label>
                ))}
              </div>
            ))}
          </div>
        </fieldset>

        <div id="ex-period" class="space-y-2" hidden>
          <p class={lab} id="ex-period-l">Period</p>
          <div id="ex-period-ctl"></div>
          <p id="ex-period-note" class="text-[0.8125rem] text-slate" aria-live="polite"></p>
        </div>

        <details class="border-t border-line pt-4">
          <summary class="cursor-pointer text-[0.9375rem] font-medium text-atlas">Layer information and map options</summary>
          <div id="ex-info" class="mt-3 space-y-2 text-[0.875rem] leading-relaxed text-graphite"></div>
          <label class="mt-4 block"><span class={lab}>Layer opacity</span><input id="ex-opacity" type="range" min="0.2" max="1" step="0.05" value="0.85" class="mt-1 w-full accent-[#3458d4]" /></label>
          <label class="mt-3 block"><span class={lab}>Basemap</span>
            <select id="ex-basemap" class="field mt-1.5">{BASEMAPS.map((b) => <option value={b.id}>{b.title}</option>)}</select></label>
        </details>
      </div>
    </aside>

    <!-- Centre: map -->
    <div class="ex-map relative">
      <div class="absolute inset-0"><div id="map" class="h-full w-full bg-limestone" role="region" aria-label="Map of Algeria. Use the Place search to select a region with the keyboard; statistics appear in the region panel."></div></div>
      <div id="legend" class="tabular pointer-events-auto absolute bottom-8 right-2 z-10 hidden max-h-[45%] w-[15rem] max-w-[calc(100%-1rem)] overflow-y-auto border border-line bg-white p-3 text-[0.8125rem] text-graphite shadow-sm" style="border-radius:var(--radius-card)" aria-label="Legend"></div>
      <noscript><p class="absolute inset-0 grid place-items-center p-6 text-center">The map needs JavaScript. All products are listed in <a href="/data/">Data</a>.</p></noscript>
    </div>

    <!-- Right: regional information -->
    <aside id="inspector" class="ex-inspector border-line bg-surface lg:border-l" aria-labelledby="ins-h" hidden>
      <div class="flex justify-end px-4 pt-3"><button type="button" id="ins-close" class="btn btn-secondary !px-2.5 !py-1 text-[0.875rem]">Close<span class="sr-only"> region panel</span></button></div>
      <div id="inspector-body" class="px-4 pb-6 lg:px-5"></div>
    </aside>
  </div>
  <script type="application/json" id="ex-data" set:html={JSON.stringify({ layers: layerInfo, datasets: datasetInfo, indicators: available })} />
</Base>

<style is:global>
  .ex-grid { display: grid; grid-template-columns: minmax(0, 1fr); }
  .ex-map { height: 62vh; min-height: 22rem; }
  @media (min-width: 1024px) {
    .ex-grid { height: calc(100dvh - 3.5rem); grid-template-columns: 20rem minmax(0, 1fr); }
    .ex-grid[data-inspector='open'] { grid-template-columns: 20rem minmax(0, 1fr) 24rem; }
    .ex-panel, .ex-inspector { overflow-y: auto; }
    .ex-map { height: auto; min-height: 0; }
  }
  .ex-ind { display: flex; gap: .625rem; align-items: flex-start; padding: .5rem .5rem; border-radius: var(--radius-control); cursor: pointer; }
  .ex-ind input { margin-top: .25rem; width: 1rem; height: 1rem; flex: none; }
  .ex-ind:hover { background: var(--color-paper); }
  .ex-ind:has(:checked) { background: #e8edfb; box-shadow: inset 3px 0 0 var(--color-cobalt); }
  .ex-ind:has(:focus-visible) { outline: 2px solid var(--color-cobalt); outline-offset: 1px; }
  .ex-badge { display: inline-block; padding: 0 .375rem; border: 1px solid var(--color-line-strong); border-radius: var(--radius-control); font-size: .75rem; line-height: 1.35rem; color: var(--color-slate); }
  .ex-badge-aeo { border-color: #b6d8c1; background: #e7f2ea; color: var(--color-success); }
</style>

<script>
  import { initExplore } from '../scripts/explore';
  initExplore();
</script>
