---
import Logo from './Logo.astro';
import { NAV, SITE } from '../config/site';
interface Props { dark?: boolean }
const { dark = true } = Astro.props; // midnight navigation on every page
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href);
---
<header class:list={['sticky top-0 z-40 border-b', dark ? 'theme-dark border-line' : 'border-line bg-chalk/95 backdrop-blur']}>
  <div class="mx-auto flex h-14 max-w-[90rem] items-center justify-between gap-6 px-5 sm:px-8 lg:px-12">
    <a href="/" class="no-underline" aria-label="Algeria Earth Observatory — home"><Logo inverse={dark} /></a>
    <nav aria-label="Main" class="hidden lg:block">
      <ul class="flex items-center gap-1 text-[0.875rem]">
        {NAV.map((n) => (
          <li>
            <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}
              class:list={['relative block px-3 py-2 no-underline transition-colors',
                isActive(n.href) ? 'text-white after:absolute after:inset-x-3 after:-bottom-[9px] after:h-[2px] after:bg-[#b6503c]' : 'text-[#c5cdd2] hover:text-white']}>{n.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <div class="hidden items-center gap-4 text-[0.8125rem] lg:flex">
      <a href={SITE.github.orgUrl} class="inline-flex min-h-6 items-center text-[#c5cdd2] no-underline hover:text-white" rel="noopener">GitHub</a>
      <ul class="flex items-center gap-1 font-mono text-[0.75rem]" aria-label="Language">
        <li><span class="grid h-6 min-w-6 place-items-center bg-white/15 px-1.5 text-white" aria-current="true">EN<span class="sr-only"> — English (current)</span></span></li>
        <li><span class="grid h-6 min-w-6 place-items-center px-1.5 text-[#9aa6ad]" title="Version française en préparation" aria-disabled="true">FR<span class="sr-only"> — French, in preparation</span></span></li>
      </ul>
    </div>
    <button id="nav-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav"
      class="inline-flex h-10 items-center gap-2 border border-line-strong px-3 text-[0.875rem] text-atlas lg:hidden" style="border-radius:var(--radius-control)">
      <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      Menu
    </button>
  </div>
  <nav id="mobile-nav" aria-label="Main" class="hidden border-t border-line lg:hidden">
    <ul class="mx-auto grid max-w-[90rem] px-5 py-2 text-[0.95rem] sm:px-8">
      {NAV.map((n) => (
        <li><a href={n.href} class="block border-b border-line py-3 text-atlas no-underline last:border-0" aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>
      ))}
      <li><a href={SITE.github.orgUrl} class="block py-3 text-atlas no-underline" rel="noopener">GitHub</a></li>
    </ul>
  </nav>
</header>
<script>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    menu?.classList.toggle('hidden', open);
  });
</script>
