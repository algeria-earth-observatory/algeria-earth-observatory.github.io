---
import Logo from './Logo.astro';
import { NAV, SITE } from '../config/site';
const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href));
---
<header class="sticky top-0 z-40 bg-white/95 backdrop-blur border-b border-line">
  <div class="container-aeo flex h-16 items-center justify-between gap-4">
    <a href="/" class="no-underline shrink-0" aria-label="Algeria Earth Observatory — home"><Logo /></a>
    <nav aria-label="Main" class="hidden xl:block">
      <ul class="flex items-center gap-1">
        {NAV.map((n) => (
          <li>
            <a
              href={n.href}
              class:list={[
                'rounded px-2.5 py-2 text-[0.92rem] font-medium no-underline transition-colors',
                isActive(n.href) ? 'text-atlas bg-mist' : 'text-graphite hover:text-signal hover:bg-paper',
              ]}
              aria-current={isActive(n.href) ? 'page' : undefined}
            >{n.label}</a>
          </li>
        ))}
        <li class="ml-1">
          <a href={SITE.github.orgUrl} class="flex items-center gap-1.5 rounded px-2.5 py-2 text-[0.94rem] font-medium text-graphite no-underline hover:text-signal hover:bg-paper" rel="noopener">
            <svg width="17" height="17" viewBox="0 0 16 16" aria-hidden="true" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.013 8.013 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>
            GitHub
          </a>
        </li>
      </ul>
    </nav>
    <button
      id="nav-toggle"
      type="button"
      class="xl:hidden inline-flex items-center gap-2 rounded border border-line px-3 py-2 text-sm font-medium text-atlas"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <svg width="18" height="18" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      Menu
    </button>
  </div>
  <nav id="mobile-nav" aria-label="Main" class="xl:hidden hidden border-t border-line bg-white">
    <ul class="container-aeo py-3 grid gap-1">
      {NAV.map((n) => (
        <li><a href={n.href} class="block rounded px-3 py-2.5 font-medium text-graphite no-underline hover:bg-paper" aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a></li>
      ))}
      <li><a href="/community/" class="block rounded px-3 py-2.5 font-medium text-graphite no-underline hover:bg-paper">Community</a></li>
      <li><a href="/support/" class="block rounded px-3 py-2.5 font-medium text-graphite no-underline hover:bg-paper">Support</a></li>
      <li><a href={SITE.github.orgUrl} class="block rounded px-3 py-2.5 font-medium text-graphite no-underline hover:bg-paper" rel="noopener">GitHub</a></li>
    </ul>
  </nav>
</header>
<script>
  const btn = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') === 'true';
    btn.setAttribute('aria-expanded', String(!open));
    menu?.classList.toggle('hidden', open);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && btn?.getAttribute('aria-expanded') === 'true') {
      btn.setAttribute('aria-expanded', 'false');
      menu?.classList.add('hidden');
      btn.focus();
    }
  });
</script>
