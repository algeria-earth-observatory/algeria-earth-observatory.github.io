---
/**
 * AEO monogram (AZIM — Amazigh Computational Modernism).
 * Built on a 2-unit pixel grid: A = triangle, E = three bars, O = lozenge.
 * Triangle and lozenge are recurrent primitives of Amazigh geometric decoration;
 * they are used here abstractly and do not reproduce a specific motif or symbol
 * (see docs/BRAND.md). Oxide red is the single artistic accent.
 */
interface Props { inverse?: boolean; compact?: boolean }
const { inverse = false, compact = false } = Astro.props;
const ink = inverse ? '#FFFFFF' : '#17252C';
const sub = inverse ? 'rgba(255,255,255,.78)' : '#586268';
---
<span class="inline-flex items-center gap-3" style={`color:${ink}`}>
  <svg viewBox="0 0 46 16" width="46" height="16" aria-hidden="true" focusable="false" class="shrink-0">
    <path d="M1 15 L7 1 L13 15" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="miter" stroke-linecap="square" />
    <path d="M4.4 10 H9.6" stroke="currentColor" stroke-width="2" />
    <rect x="18" y="1" width="9" height="2" fill="currentColor" />
    <rect x="18" y="7" width="7" height="2" fill="currentColor" />
    <rect x="18" y="13" width="9" height="2" fill="currentColor" />
    <path d="M38 1 L45 8 L38 15 L31 8 Z" fill="none" stroke="#B6503C" stroke-width="2" stroke-linejoin="miter" />
    <rect x="37" y="7" width="2" height="2" fill="#B6503C" />
  </svg>
  {!compact && <span class="hidden text-[0.875rem] leading-none sm:inline" style={`color:${sub}`}>Algeria Earth Observatory</span>}
</span>
