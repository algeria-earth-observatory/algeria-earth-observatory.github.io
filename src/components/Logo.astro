---
interface Props { inverse?: boolean; compact?: boolean }
const { inverse = false, compact = false } = Astro.props;
const ink = inverse ? '#F7F9FA' : '#143B56';
const uid = inverse ? 'aeo-disc-i' : 'aeo-disc';
---
<span class="inline-flex items-center gap-2.5">
  <svg viewBox="0 0 40 40" width="34" height="34" aria-hidden="true" focusable="false">
    <defs><clipPath id={uid}><circle cx="20" cy="20" r="16" /></clipPath></defs>
    <g clip-path={`url(#${uid})`}>
      <rect width="40" height="40" fill={inverse ? '#0E2A3E' : '#143B56'} />
      <rect y="10.2" width="40" height="2.6" fill="#008C91" />
      <rect y="14.6" width="40" height="3.2" fill="#008C91" opacity=".55" />
      <rect y="19.6" width="40" height="4.2" fill="#D8C4A1" opacity=".7" />
      <rect y="25.6" width="40" height="14.4" fill="#D8C4A1" />
    </g>
    <circle cx="20" cy="20" r="16" fill="none" stroke={ink} stroke-width="1.6" />
    <path d="M3.2 27.5 A18.5 7 -24 0 1 34.8 10.6" fill="none" stroke={inverse ? '#5FA8E8' : '#176BBA'} stroke-width="1.8" stroke-linecap="round" />
    <rect x="33" y="5.6" width="5" height="5" rx=".6" fill={inverse ? '#5FA8E8' : '#176BBA'} />
  </svg>
  <span class="leading-none" style={`color:${ink}`}>
    <span class="block font-semibold tracking-tight text-[1.02rem]">Algeria Earth Observatory</span>
    {!compact && <span class="block font-mono text-[0.66rem] uppercase tracking-[0.12em] mt-1 opacity-75">Open Earth Data for Algeria</span>}
  </span>
</span>
