---
/**
 * AEO monogram (AZIM — Amazigh Computational Modernism), after the approved overview.
 * A = layered chevrons in oxide (triangle primitives), E = Ξ three bars, O = circle.
 * Primitives are used abstractly; no specific motif is reproduced (docs/BRAND.md).
 */
interface Props { inverse?: boolean; compact?: boolean; size?: number; /** mark only, scales to its container width */ fluid?: boolean; label?: string }
const { inverse = false, compact = false, size = 18, fluid = false, label } = Astro.props;
const ink = inverse ? '#FFFFFF' : '#17252C';
const sub = inverse ? 'rgba(255,255,255,.8)' : '#586268';
const w = Math.round((size * 58) / 18);
---
<span class="inline-flex items-center gap-3" style={`color:${ink}`}>
  <svg viewBox="0 0 58 18" width={fluid ? undefined : w} height={fluid ? undefined : size} class:list={['shrink-0', fluid && 'block h-auto w-full']} focusable="false" {...(label ? { role: 'img', 'aria-label': label } : { 'aria-hidden': 'true' })}>
    <path d="M0 18 L9 0 L18 18 H14.4 L9 7.2 L3.6 18 Z" fill="#B6503C" />
    <path d="M5.6 18 L9 11.2 L12.4 18 H10.3 L9 15.4 L7.7 18 Z" fill="#B6503C" />
    <rect x="22" y="0.5" width="12" height="2.6" fill="currentColor" />
    <rect x="23.5" y="7.7" width="9" height="2.6" fill="currentColor" />
    <rect x="22" y="14.9" width="12" height="2.6" fill="currentColor" />
    <circle cx="48.5" cy="9" r="7.7" fill="none" stroke="currentColor" stroke-width="2.6" />
  </svg>
  {!compact && !fluid && <>
    <span class="hidden h-5 w-px bg-current opacity-40 sm:block" aria-hidden="true"></span>
    <span class="hidden text-[0.8125rem] leading-none sm:inline" style={`color:${sub}`}>Algeria Earth Observatory</span>
  </>}
</span>
