---
import Logo from './Logo.astro';
import GeoBand from './GeoBand.astro';
import { SITE } from '../config/site';
const links = [
  { href: '/about/', label: 'About' },
  { href: '/docs/', label: 'Methods' },
  { href: '/data/', label: 'Data' },
  { href: SITE.github.orgUrl, label: 'GitHub', ext: true },
  { href: '/contribute/', label: 'Contribute' },
  { href: '/licenses/', label: 'Licensing' },
  { href: '/contact/', label: 'Contact' },
];
---
<footer class="border-t border-line">
  <GeoBand tone="muted" />
  <div class="mx-auto grid max-w-[90rem] gap-8 px-5 py-12 sm:px-8 lg:grid-cols-12 lg:px-12">
    <div class="lg:col-span-5">
      <Logo />
      <p class="mt-4 max-w-md text-[0.875rem] leading-relaxed text-slate">
        Algeria Earth Observatory is an independent scientific initiative. It is not a government service and is not affiliated with or endorsed by any institution.
      </p>
    </div>
    <nav aria-label="Footer" class="lg:col-span-7">
      <ul class="grid grid-cols-2 gap-x-8 gap-y-2.5 text-[0.875rem] sm:grid-cols-4">
        {links.map((l) => <li><a href={l.href} class="text-graphite no-underline hover:text-cobalt" rel={l.ext ? 'noopener' : undefined}>{l.label}</a></li>)}
      </ul>
    </nav>
  </div>
  <div class="border-t border-line">
    <div class="mx-auto flex max-w-[90rem] flex-col gap-1 px-5 py-4 font-mono text-[0.72rem] text-slate sm:flex-row sm:justify-between sm:px-8 lg:px-12">
      <p>Code MIT · Text CC BY 4.0 · Each dataset keeps its own licence</p>
      <p>Map data © OpenStreetMap contributors · Imagery NASA EOSDIS GIBS</p>
    </div>
  </div>
</footer>
