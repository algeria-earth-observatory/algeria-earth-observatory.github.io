---
/**
 * Complete file inventory of an Algeria-ready AEO product, generated from its manifest
 * (the same source the RegionDataDownloader resolves against). Statements about which
 * spatial files exist are computed from the manifest, never written by hand.
 */
import type { Dataset } from '../content.config';
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
interface Props { d: Dataset }
const { d } = Astro.props;
const manifest = JSON.parse(readFileSync(join(process.cwd(), 'public', d.product!.manifest), 'utf-8'));
const assets = manifest.download_assets as { href: string; format: string; level: string | null; unit_code?: string; title: string; bytes: number; sha256: string }[];
const mb = (b: number) => (b >= 1e6 ? `${(b / 1e6).toFixed(1)} MB` : `${Math.max(1, Math.round(b / 1e3))} kB`);
const LEVEL = { admin0: 'Algeria', admin1: 'wilaya', admin2: 'commune' } as Record<string, string>;
const cogs = assets.filter((a) => a.format === 'COG');
const nat = cogs.filter((a) => a.level === 'admin0');
const wil = cogs.filter((a) => a.level === 'admin1');
const com = cogs.filter((a) => a.level === 'admin2');
const tables = assets.filter((a) => a.format === 'CSV' || a.format === 'PARQUET');
const base = d.product!.manifest.replace(/manifest\.json$/, '');
const spatialSentence = [
  `${nat.length} GeoTIFF file${nat.length === 1 ? '' : 's'} for Algeria`,
  wil.length ? `${wil.length} wilaya GeoTIFFs (one per wilaya)` : 'no wilaya GeoTIFFs',
  com.length ? `${com.length} commune GeoTIFFs` : 'no commune GeoTIFFs',
].join(', ');
const levelsTables = [...new Set(tables.map((a) => LEVEL[a.level ?? ''] ?? a.level))].join(', ');
---
<details class="rounded-md border border-line bg-surface p-4 text-[0.9375rem]" id="all-files">
  <summary class="min-h-6 cursor-pointer font-medium text-atlas">All files in this product ({assets.length}) and metadata</summary>
  <p class="mt-3 text-slate">From the product manifest: {spatialSentence}; statistics tables for {levelsTables} levels.</p>
  <h3 class="mt-4 font-medium text-atlas">Spatial grids (GeoTIFF, Cloud Optimized)</h3>
  <ul class="mt-1 space-y-1.5">{nat.map((a) => <li><a href={a.href} download>{a.title}</a> <span class="meta">{mb(a.bytes)} · SHA-256 {a.sha256.slice(0, 12)}…</span></li>)}</ul>
  {wil.length > 0 && <p class="mt-2 text-slate">Wilaya files: choose a wilaya in the download assistant above (format “GeoTIFF”). Each is listed in the <a href={d.product!.manifest}>manifest</a> with its size and SHA-256.</p>}
  <h3 class="mt-4 font-medium text-atlas">Statistics tables (all units of a level)</h3>
  <ul class="mt-1 space-y-1.5">{tables.map((a) => <li><a href={a.href} download>{a.title}</a> <span class="meta">{a.format === 'PARQUET' ? 'Parquet' : a.format} · {mb(a.bytes)}</span></li>)}</ul>
  <h3 class="mt-4 font-medium text-atlas">Metadata</h3>
  <ul class="mt-1 space-y-1.5">
    <li><a href={d.product!.manifest}>Product manifest (JSON)</a>: every file with its size and SHA-256</li>
    <li><a href={`${base}PROVENANCE.json`}>Provenance and quality checks (JSON)</a></li>
    <li><a href={`/data/${d.id}.stac.json`}>STAC collection</a> · <a href={`/data/${d.id}.json`}>catalog record (JSON)</a></li>
  </ul>
</details>
