---
import type { Dataset } from '../content.config';
import { STATUS, NATURE } from '../lib/format';
interface Props { d: Dataset; size?: 'sm' | 'md' }
const { d } = Astro.props;
const st = STATUS[d.status];
const nat = d.data_nature ? NATURE[d.data_nature] : null;
---
<span class="inline-flex flex-wrap items-center gap-x-3 gap-y-1">
  <span class:list={['status', st.cls]} title={st.help}>{st.label}</span>
  {nat && <span class="meta !text-[0.72rem]" title={nat.help}>{nat.label}</span>}
</span>
