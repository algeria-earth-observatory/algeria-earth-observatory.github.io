---
import type { Dataset } from '../content.config';
import { STATUS, NATURE } from '../lib/format';
interface Props { d: Dataset; size?: 'sm' | 'md' }
const { d, size = 'sm' } = Astro.props;
const st = STATUS[d.status];
const nat = d.data_nature ? NATURE[d.data_nature] : null;
const pad = size === 'md' ? 'px-2.5 py-1 text-[0.8rem]' : 'px-2 py-0.5 text-[0.72rem]';
---
<span class="inline-flex flex-wrap items-center gap-1.5">
  <span class:list={['inline-flex items-center gap-1 whitespace-nowrap rounded border font-semibold', pad, st.cls]} title={st.help}>
    {d.status === 'available' && <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M5 1v6M2 5l3 3 3-3" stroke="currentColor" stroke-width="1.6" fill="none"/></svg>}
    {d.status === 'external' && <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><path d="M4 1h5v5M9 1L3.5 6.5M7 6v3H1V3h3" stroke="currentColor" stroke-width="1.3" fill="none"/></svg>}
    {d.status === 'in-preparation' && <svg width="10" height="10" viewBox="0 0 10 10" aria-hidden="true"><circle cx="5" cy="5" r="3.6" stroke="currentColor" stroke-width="1.3" fill="none" stroke-dasharray="2 1.4"/></svg>}
    {st.label}
  </span>
  {nat && (
    <span class:list={['inline-flex items-center rounded border border-line bg-surface font-mono font-medium text-slate', pad]} title={nat.help}>
      {nat.label}
    </span>
  )}
</span>
